<!--
  certificate-poc.html.mustache — E12S01 AC2 PoC HTML+CSS certificate template

  HTML certificate template following E08S07 print-layout patterns (DEC-12).
  Self-contained (no partial includes — spike only).

  Required model attributes:
    [placement] - e.g. "1. Platz"
    [teamName]  - e.g. "VB Muster"
    [teamPhoto] - base64 data URI, e.g. "data:image/png;base64,..."

  AC2 features verified:
    - Placement, team name, photo via img tag
    - Decorative CSS: gold border, background colors, certificate layout
    - @media print rules for A4 output (reusing print.css conventions from E08S07)

  AC4 findings:
    - Tested: A4 page sizing via @page { size: A4 landscape; }
    - Image rendering: img with base64 data URI renders correctly in Chrome/Firefox print
    - Decorative elements: background-color requires -webkit-print-color-adjust: exact
    - Page break behavior: single-page certificate, no page breaks needed

  NOTE: Use HTML comments (not Mustache comments) in this template to avoid jmustache
  comment-termination-on-first-closing-braces behaviour. AC6 finding: jmustache Mustache
  comments terminate on the first pair of closing braces in the comment body.
-->
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>Urkunde — {{teamName}}</title>
    <style>
        /* ============================================================
           CERTIFICATE SCREEN STYLES
           ============================================================ */

        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f0f0e8;
            margin: 0;
            padding: 20px;
            color: #222;
        }

        .certificate {
            width: 297mm;
            min-height: 210mm;
            margin: 0 auto;
            background: white;
            border: 8px solid #DAA520;
            border-radius: 12px;
            padding: 40px 60px;
            position: relative;
            box-shadow: 0 4px 24px rgba(0,0,0,0.15);
        }

        /* AC2: Decorative CSS — double border and corner accent */
        .certificate::before {
            content: '';
            position: absolute;
            top: 10px;
            left: 10px;
            right: 10px;
            bottom: 10px;
            border: 2px solid #DAA520;
            border-radius: 8px;
            pointer-events: none;
        }

        .certificate-header {
            text-align: center;
            padding-bottom: 20px;
            border-bottom: 2px solid #DAA520;
            margin-bottom: 30px;
        }

        .certificate-title {
            font-size: 52pt;
            font-weight: bold;
            color: #8B6914;
            margin: 0;
            letter-spacing: 4px;
            /* AC2: decorative background color on title area */
            background: linear-gradient(135deg, #f5e642 0%, #e8a800 40%, #ffd700 70%, #c8860a 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .certificate-subtitle {
            font-size: 16pt;
            color: #666;
            margin: 8px 0 0;
        }

        .certificate-body {
            text-align: center;
        }

        .placement {
            font-size: 72pt;
            font-weight: bold;
            color: #8B6914;
            margin: 10px 0;
            /* AC2: decorative background color */
            background-color: #fffbe6;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
            display: inline-block;
            padding: 10px 40px;
            border-radius: 8px;
        }

        .placement-label {
            font-size: 14pt;
            color: #555;
            margin: 0 0 10px;
        }

        .team-name {
            font-size: 32pt;
            font-weight: bold;
            color: #4a3000;
            margin: 16px 0 24px;
        }

        /* AC2: Photo via <img> tag */
        .team-photo {
            width: 180px;
            height: 140px;
            object-fit: cover;
            border: 3px solid #DAA520;
            border-radius: 6px;
            display: block;
            margin: 0 auto 24px;
        }

        .certificate-footer {
            margin-top: 30px;
            padding-top: 16px;
            border-top: 1px solid #DAA520;
            display: flex;
            justify-content: space-around;
            color: #777;
            font-size: 10pt;
        }

        .signature-line {
            width: 200px;
            border-bottom: 1px solid #8B6914;
            text-align: center;
            padding-top: 40px;
        }

        /* Corner ornaments (AC2: decorative CSS) */
        .corner-ornament {
            position: absolute;
            font-size: 24px;
            color: #DAA520;
            opacity: 0.6;
        }

        .corner-ornament--tl { top: 20px;  left:  20px; }
        .corner-ornament--tr { top: 20px;  right: 20px; }
        .corner-ornament--bl { bottom: 20px; left:  20px; }
        .corner-ornament--br { bottom: 20px; right: 20px; }

        /* ============================================================
           @MEDIA PRINT — AC4: A4 layout, image quality, decorative fidelity
           ============================================================ */

        @media print {
            /* AC4: A4 landscape for certificate */
            @page {
                size: A4 landscape;
                margin: 8mm 10mm;
            }

            body {
                background: white;
                padding: 0;
                margin: 0;
            }

            .certificate {
                width: 100%;
                min-height: auto;
                border: 6pt solid #DAA520 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                border-radius: 8pt;
                box-shadow: none;
                padding: 24pt 40pt;
            }

            .certificate::before {
                border: 1.5pt solid #DAA520 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .certificate-title {
                /* AC4: gradient text-fill may not print; fallback to solid color */
                -webkit-text-fill-color: #8B6914;
                background: none;
                color: #8B6914;
                font-size: 40pt;
            }

            .placement {
                background-color: #fffbe6 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                font-size: 56pt;
            }

            /* AC4: Image rendering quality — data URI images print at full quality */
            .team-photo {
                width: 140px;
                height: 110px;
                border: 2pt solid #DAA520 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            /* AC4: Page break behavior — single certificate, no breaks needed */
            .certificate {
                page-break-inside: avoid;
                break-inside: avoid;
            }
        }
    </style>
</head>
<body>
    <div class="certificate">
        <!-- Corner ornaments (AC2: decorative CSS) -->
        <span class="corner-ornament corner-ornament--tl">&#x2726;</span>
        <span class="corner-ornament corner-ornament--tr">&#x2726;</span>
        <span class="corner-ornament corner-ornament--bl">&#x2726;</span>
        <span class="corner-ornament corner-ornament--br">&#x2726;</span>

        <div class="certificate-header">
            <h1 class="certificate-title">Urkunde</h1>
            <p class="certificate-subtitle">Volleyball-Turnier</p>
        </div>

        <div class="certificate-body">
            <!-- AC2: Photo via <img> tag ({{teamPhoto}} = base64 data URI) -->
            <img class="team-photo"
                 src="{{teamPhoto}}"
                 alt="Mannschaftsfoto {{teamName}}">

            <p class="placement-label">belegte den</p>

            <!-- AC2: Placement placeholder -->
            <div class="placement">{{placement}}</div>

            <!-- AC2: Team name placeholder -->
            <h2 class="team-name">{{teamName}}</h2>
        </div>

        <div class="certificate-footer">
            <div class="signature-line">Datum</div>
            <div class="signature-line">Unterschrift</div>
        </div>
    </div>
</body>
</html>
