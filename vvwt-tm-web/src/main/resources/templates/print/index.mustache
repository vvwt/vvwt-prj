{{<print/print-layout}}
{{$viewportMeta}}{{/viewportMeta}}
{{$bodyClass}}{{/bodyClass}}
{{$content}}
    <h2>{{heading}}</h2>

    {{! E53S03 AC-TEST-INDEX-GATE-NO-ACTIVE-PHASE-RED: conditional rendering based on linksAvailable }}
    {{#linksAvailable}}
    <ul>
        <li><a href="{{laufzettelUrl}}">{{msgLaufzettelLink}}</a></li>
        {{#fotosUrl}}<li><a href="{{fotosUrl}}">{{msgFotosLink}}</a></li>{{/fotosUrl}}
    </ul>
    {{! E08S10 AC-INDEX-TEAM-LINKS: per-team laufzettel section }}
    {{#hasTeamLinks}}
    <h3>{{msgTeamLinksHeading}}</h3>
    <ul>
        {{#teamLinks}}<li><a href="{{url}}">{{teamNumber}} — {{teamName}}</a></li>{{/teamLinks}}
    </ul>
    {{/hasTeamLinks}}
    {{/linksAvailable}}
    {{^linksAvailable}}
    <p class="print-empty-state">{{noActivePhaseMessage}}</p>
    {{/linksAvailable}}
{{/content}}
{{/print/print-layout}}
