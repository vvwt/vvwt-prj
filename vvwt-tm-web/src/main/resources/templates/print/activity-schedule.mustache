{{<print/print-layout}}
{{$content}}
<main class="activity-schedule-main">
    <h2 class="activity-schedule-heading">{{heading}}</h2>

    <table class="activity-schedule-table">
        <thead>
            <tr>
                <th class="activity-schedule-col-round">{{msgColRound}}</th>
                {{#hasTime}}<th class="activity-schedule-col-time">{{msgColTime}}</th>{{/hasTime}}
                <th class="activity-schedule-col-teams">{{msgColTeams}}</th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}
            {{#isBreak}}
            <tr class="activity-schedule-row-break">
                <td colspan="3" class="activity-schedule-break-cell">
                    {{breakLabel}}{{#breakTimeWindow}} ({{breakTimeWindow}}){{/breakTimeWindow}}
                </td>
            </tr>
            {{/isBreak}}
            {{#isDataRow}}
            <tr class="activity-schedule-row-data">
                <td class="activity-schedule-col-round">{{roundNumber}}</td>
                {{#timeWindow}}<td class="activity-schedule-col-time">{{timeWindow}}</td>{{/timeWindow}}
                {{^timeWindow}}<td class="activity-schedule-col-time"></td>{{/timeWindow}}
                <td class="activity-schedule-col-teams">{{teamNames}}</td>
            </tr>
            {{/isDataRow}}
            {{/rows}}
        </tbody>
    </table>

    {{! AC5: summary line — totalTeams and totalRounds substituted inline }}
    <p class="activity-schedule-summary">
        {{totalTeams}} Mannschaften, verteilt auf {{totalRounds}} Runden.
    </p>

    {{! AC6: unassigned warning section }}
    {{#hasUnassigned}}
    <div class="activity-schedule-unassigned">
        <p class="activity-schedule-unassigned-title">{{msgUnassignedTitle}}: {{activityName}}</p>
        <ul class="activity-schedule-unassigned-list">
            {{#unassignedTeams}}
            <li>{{teamName}}</li>
            {{/unassignedTeams}}
        </ul>
    </div>
    {{/hasUnassigned}}
</main>
{{/content}}
{{/print/print-layout}}
