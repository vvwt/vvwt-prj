{{!
  activity-schedule.mustache — Mannschaftsfoto-Übersicht: activity schedule print template.

  E08S09 AC1–AC11:
  - Renders a photographer-centric round table for one activity type (AC3).
  - Time column shown only when {{hasTime}} is truthy (AC7).
  - Break separator rows interleaved in {{rows}} (AC4).
  - Summary line below table (AC5).
  - Warning section for unassigned teams when {{hasUnassigned}} (AC6).
  - All static text via model attributes (i18n — AC10).
  - CSS @media print from print.css (AC8).

  Required model attributes (all set by PrintController):
    {{tournamentName}}, {{tournamentDate}}, {{phaseName}}, {{msgTournamentLabel}},
    {{msgDateLabel}}, {{msgPhaseLabel}}, {{cssPath}}, {{appVersion}}, {{locale}}
      — shared print-header partial attributes
    {{title}}            — page title (browser tab / print header)
    {{heading}}          — e.g. "Mannschaftsfoto — Zeitplan"
    {{activityName}}     — human-readable activity type name
    {{hasTime}}          — boolean: whether to show time column
    {{rows}}             — list of row attribute maps (from ActivityScheduleAssembler)
    {{totalTeams}}       — total assigned team count (AC5)
    {{totalRounds}}      — count of non-empty rounds (AC5)
    {{hasUnassigned}}    — boolean: show warning section
    {{unassignedTeams}}  — list of {teamName} maps (AC6)
    {{msgColRound}}, {{msgColTime}}, {{msgColTeams}} — column headers
    {{msgSummary}}       — summary text template (AC5)
    {{msgUnassignedTitle}} — warning section heading (AC6)
    {{msgBreakLabel}}    — fallback break label
}}
<!DOCTYPE html>
<html lang="{{locale}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="stylesheet" href="{{cssPath}}">
</head>
<body class="print-body">

{{> print-header}}

<main class="activity-schedule-main">
    <h2 class="activity-schedule-heading">{{heading}}</h2>

    <table class="activity-schedule-table">
        <thead>
            <tr>
                <th class="activity-schedule-col-round">{{msgColRound}}</th>
                {{#hasTime}}<th class="activity-schedule-col-time">{{msgColTime}}</th>{{/hasTime}}
                <th class="activity-schedule-col-teams">{{msgColTeams}}</th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}
            {{#isBreak}}
            <tr class="activity-schedule-row-break">
                <td colspan="3" class="activity-schedule-break-cell">
                    {{breakLabel}}{{#breakTimeWindow}} ({{breakTimeWindow}}){{/breakTimeWindow}}
                </td>
            </tr>
            {{/isBreak}}
            {{#isDataRow}}
            <tr class="activity-schedule-row-data">
                <td class="activity-schedule-col-round">{{roundNumber}}</td>
                {{#timeWindow}}<td class="activity-schedule-col-time">{{timeWindow}}</td>{{/timeWindow}}
                {{^timeWindow}}<td class="activity-schedule-col-time"></td>{{/timeWindow}}
                <td class="activity-schedule-col-teams">{{teamNames}}</td>
            </tr>
            {{/isDataRow}}
            {{/rows}}
        </tbody>
    </table>

    {{! AC5: summary line — totalTeams and totalRounds substituted inline }}
    <p class="activity-schedule-summary">
        {{totalTeams}} Mannschaften, verteilt auf {{totalRounds}} Runden.
    </p>

    {{! AC6: unassigned warning section }}
    {{#hasUnassigned}}
    <div class="activity-schedule-unassigned">
        <p class="activity-schedule-unassigned-title">{{msgUnassignedTitle}}: {{activityName}}</p>
        <ul class="activity-schedule-unassigned-list">
            {{#unassignedTeams}}
            <li>{{teamName}}</li>
            {{/unassignedTeams}}
        </ul>
    </div>
    {{/hasUnassigned}}
</main>

<div class="print-footer">
    <small>v{{appVersion}}</small>
</div>

</body>
</html>
