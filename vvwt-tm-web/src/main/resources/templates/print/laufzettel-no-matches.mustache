<!--
  laufzettel-no-matches.mustache — error page when matches have not been generated yet.

  E08S08 AC13:
  - Shown when the tournament has phases but no slot-optimized matches exist.
  - Human-readable HTML, not a JSON error (consistent with print/error.mustache pattern).
  - All text via model attributes (i18n).

  Required model attributes:
    tournamentName, tournamentDate, phaseName, msgTournamentLabel,
    msgDateLabel, msgPhaseLabel, cssPath — shared header model
    title        — page title
    heading      — error heading
    msgNoMatches — explanatory error message
-->
<!DOCTYPE html>
<html lang="{{locale}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="stylesheet" href="{{cssPath}}">
</head>
<body class="print-body">

{{> print-header}}

<main class="print-error-main">
    <h2 class="print-error-heading">{{heading}}</h2>
    <p class="print-error-message">{{msgNoMatches}}</p>
</main>

</body>
</html>
