<!DOCTYPE html>
<html lang="{{locale}}">
<head>
    <meta charset="UTF-8">
    <title>{{title}}</title>
    <!-- E08S07 AC3, AC6: print stylesheet — bundled, no CDN (DEC-15) -->
    <link rel="stylesheet" href="{{cssPath}}">
</head>
<body>

    {{! E08S07 AC5: shared print header partial }}
    {{> print-header}}

    <div class="print-error">
        <p class="print-error__heading">{{heading}}</p>
        <p>{{msgNophase}}</p>
    </div>

    <div class="print-footer">
        <small>v{{appVersion}}</small>
    </div>

</body>
</html>
