<!DOCTYPE html>
<html lang="{{locale}}">
<head>
    <meta charset="UTF-8">
    {{$viewportMeta}}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{/viewportMeta}}
    <title>{{title}}</title>
    <!-- E08S07 AC3, AC6: print stylesheet — bundled, no CDN (DEC-15) -->
    <link rel="stylesheet" href="{{cssPath}}">
</head>
<body{{$bodyClass}} class="print-body"{{/bodyClass}}>

{{> print-header}}

{{$content}}{{/content}}

{{$footer}}
<div class="print-footer">
    <small>v{{appVersion}}</small>
</div>
{{/footer}}

</body>
</html>
