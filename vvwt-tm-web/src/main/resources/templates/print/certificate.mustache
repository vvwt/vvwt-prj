{{!
  certificate.mustache — single HTML certificate print template.

  E12S06 AC2, AC6, AC10, AC11:
  - Renders a single certificate for one team using the print base layout.
  - All 6 Session Brief D-4 template variables are provided by CertificateAssembler.
  - CSS @media print from print.css ensures A4 landscape fit.
  - Photo displayed via <img> if {{hasPhoto}} is truthy; hidden if no photo uploaded.
  - Inherits /print/** auth enforcement (AC11).

  Required model attributes (set by PrintController):
    {{tournamentName}}, {{tournamentDate}}, {{phaseName}}, {{msgTournamentLabel}},
    {{msgDateLabel}}, {{msgPhaseLabel}}, {{cssPath}}  — shared header model (print-header partial)
    {{title}}               — page title (browser tab)
    {{singleCertificate}}   — map with all 6 D-4 variables:
      {{placement}}, {{teamName}}, {{teamPhoto}}, {{tournamentName}}, {{date}}, {{location}}, {{hasPhoto}}
}}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="stylesheet" href="{{cssPath}}">
    <style>
        .certificate-page {
            width: 297mm;
            min-height: 210mm;
            margin: 0 auto;
            padding: 20mm;
            box-sizing: border-box;
            border: 4px double #8B6914;
            font-family: Arial, sans-serif;
            text-align: center;
            position: relative;
        }
        .certificate-placement {
            font-size: 2.5em;
            font-weight: bold;
            color: #8B6914;
            margin: 10mm 0 5mm 0;
        }
        .certificate-team-name {
            font-size: 2em;
            font-weight: bold;
            margin: 5mm 0;
        }
        .certificate-tournament-name {
            font-size: 1.4em;
            margin: 5mm 0;
        }
        .certificate-meta {
            font-size: 1em;
            color: #555;
            margin: 3mm 0;
        }
        .certificate-photo {
            max-width: 80mm;
            max-height: 60mm;
            margin: 8mm auto;
            display: block;
        }
        @media print {
            @page {
                size: A4 landscape;
                margin: 0;
            }
            body { margin: 0; }
            .certificate-page {
                page-break-after: always;
                border: 4px double #8B6914;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body class="print-body">

{{> print-header}}

{{#singleCertificate}}
<div class="certificate-page">
    <div class="certificate-placement">Platz {{placement}}</div>
    <div class="certificate-team-name">{{teamName}}</div>
    {{#hasPhoto}}<img class="certificate-photo" src="{{teamPhoto}}" alt="Mannschaftsfoto">{{/hasPhoto}}
    <div class="certificate-tournament-name">{{tournamentName}}</div>
    <div class="certificate-meta">{{date}} &mdash; {{location}}</div>
</div>
{{/singleCertificate}}

</body>
</html>
