            vvwtHide(elNoMatchPanel);
            if (elTapToRefreshPanel) { vvwtShow(elTapToRefreshPanel); }
        }, IDLE_TIMEOUT_MS);
    }

    /*
     * AC3 (E65S07): Cancel the idle timeout if it is running. Idempotent.
     * Called when a match is found (renderMatch) or when the page goes hidden.
