<!DOCTYPE html>
<html lang="{{locale}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <style>
        /*
         * E06S06 / E06S07 — Score entry page styles.
         * iOS 9 Safari compatible: no flexbox/grid quirks, no CSS container queries.
         * DEC-19: scoring tablet surface; Mustache + ES5 only.
         */
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            font-size: 18px;
            background: #1a1a2e;
            color: #eee;
            text-align: center;
        }
        #page-wrapper {
            padding: 20px 16px 40px;
            max-width: 540px;
            margin: 0 auto;
        }
        h1 {
            font-size: 1.2em;
            color: #aaa;
            margin: 0 0 4px;
            font-weight: normal;
        }
        #field-label {
            font-size: 0.85em;
            color: #666;
            margin-bottom: 20px;
        }
        #error-banner {
            display: none;
            background: #c0392b;
            color: #fff;
            padding: 12px 16px;
            margin-bottom: 16px;
            border-radius: 4px;
            font-size: 0.9em;
        }
        #status-msg {
            font-size: 0.95em;
            color: #777;
            margin-bottom: 20px;
            min-height: 1.4em;
        }
        #no-match-panel {
            display: none;
            padding: 32px 16px;
            color: #666;
            font-size: 1em;
        }
        /* E06S07 AC3 / AC5: side swap notification banner */
        #swap-notification {
            display: none;
            background: #2471a3;
            color: #fff;
            padding: 12px 16px;
            margin-bottom: 16px;
            border-radius: 4px;
            font-size: 0.9em;
        }
        /* E06S06 AC11: queue status */
        #queue-status {
            display: none;
            font-size: 0.75em;
            color: #888;
            margin-bottom: 12px;
        }
        /* =====================================================================
           E06S07 AC1: Initial side selection panel
           ===================================================================== */
        #side-selection-panel {
            display: none;
            padding: 16px;
        }
        #side-selection-heading {
            font-size: 1.1em;
            color: #ddd;
            margin-bottom: 8px;
        }
        #side-selection-prompt {
            font-size: 0.85em;
            color: #888;
            margin-bottom: 20px;
        }
        #side-preview {
            margin-bottom: 16px;
        }
        .side-col {
            display: inline-block;
            width: 44%;
            vertical-align: top;
        }
        .side-col-label {
            font-size: 0.75em;
            color: #666;
            margin-bottom: 4px;
        }
        .side-team-name {
            font-size: 1.1em;
            font-weight: bold;
            color: #f0f0f0;
        }
        #side-vs-label {
            display: inline-block;
            width: 12%;
            vertical-align: middle;
            font-size: 0.9em;
            color: #555;
        }
        #side-swap-btn {
            display: block;
            width: 80%;
            margin: 0 auto 16px;
            padding: 12px 0;
            font-size: 1em;
            background: #555;
            color: #eee;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }
        #match-start-btn {
            display: block;
            width: 90%;
            margin: 0 auto;
            padding: 14px 0;
            font-size: 1.1em;
            background: #27ae60;
            color: #fff;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }
        /* =====================================================================
           E06S06 AC3 / E06S07: Match display + score entry panel
           ===================================================================== */
        #match-panel {
            display: none;
        }
        /* E06S07 AC8: set counter */
        #set-counter-row {
            font-size: 0.85em;
            color: #7ec8e3;
            margin-bottom: 4px;
            font-weight: bold;
        }
        #team-row {
            margin-bottom: 6px;
        }
        #team1-name, #team2-name {
            font-size: 1.3em;
            font-weight: bold;
            color: #f0f0f0;
            display: inline-block;
            min-width: 120px;
        }
        #vs-label {
            font-size: 0.9em;
            color: #555;
            display: inline-block;
            margin: 0 12px;
            vertical-align: middle;
        }
        /* E06S07 AC9: side indicators */
        #side-indicator-row {
            font-size: 0.75em;
            color: #555;
            margin-bottom: 6px;
        }
        #side-left-label {
            display: inline-block;
            min-width: 120px;
        }
        #side-right-label {
            display: inline-block;
            min-width: 120px;
        }
        #lap-set-row {
            font-size: 0.8em;
            color: #666;
            margin-bottom: 20px;
        }
        #referee-row {
            font-size: 0.8em;
            color: #555;
            margin-bottom: 24px;
        }
        /* E06S07 AC4: manual swap button during match */
        #match-swap-btn {
            display: inline-block;
            padding: 8px 18px;
            font-size: 0.85em;
            background: #444;
            color: #ccc;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            margin-bottom: 16px;
        }
        #score-area {
            margin-bottom: 28px;
        }
        .score-col {
            display: inline-block;
            width: 45%;
            vertical-align: top;
        }
        .score-col-label {
            font-size: 0.8em;
            color: #888;
            margin-bottom: 8px;
        }
        .score-display {
            font-size: 3.5em;
            font-weight: bold;
            color: #fff;
            background: #2d2d54;
            border-radius: 8px;
            padding: 12px 0;
            min-width: 80px;
            display: inline-block;
            margin-bottom: 10px;
            width: 100%;
        }
        .btn-plus, .btn-minus {
            display: inline-block;
            width: 44%;
            padding: 10px 0;
            font-size: 1.4em;
            font-weight: bold;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            margin: 2px 1%;
        }
        .btn-plus  { background: #27ae60; color: #fff; }
        .btn-minus { background: #7f8c8d; color: #fff; }
        .score-input {
            width: 80%;
            font-size: 1.2em;
            text-align: center;
            padding: 6px 4px;
            margin-top: 8px;
            background: #23234a;
            color: #eee;
            border: 1px solid #444;
            border-radius: 4px;
        }
        #confirm-btn {
            display: block;
            width: 90%;
            margin: 0 auto 20px;
            padding: 14px 0;
            font-size: 1.1em;
            background: #2980b9;
            color: #fff;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }
        /* E06S06 AC5: confirm dialog */
        #confirm-dialog {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.7);
            z-index: 100;
        }
        #confirm-dialog-box {
            background: #22224a;
            border-radius: 10px;
            padding: 32px 24px 24px;
            margin: 18% auto 0;
            max-width: 380px;
            width: 90%;
        }
        #confirm-dialog-heading {
            font-size: 1.1em;
            color: #eee;
            margin-bottom: 10px;
        }
        #confirm-dialog-prompt {
            font-size: 0.95em;
            color: #aaa;
            margin-bottom: 24px;
        }
        #confirm-dialog-score {
            font-size: 2em;
            font-weight: bold;
            color: #fff;
            margin-bottom: 24px;
        }
        .confirm-dialog-btn {
            display: inline-block;
            width: 44%;
            margin: 0 2%;
            padding: 12px 0;
            font-size: 1em;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }
        #confirm-yes-btn { background: #27ae60; color: #fff; }
        #confirm-no-btn  { background: #555; color: #eee; }
        /* =====================================================================
           E06S07 AC6: Match result summary panel
           ===================================================================== */
        #match-result-panel {
            display: none;
            padding: 24px 16px;
        }
        #match-result-heading {
            font-size: 1.3em;
            color: #eee;
            margin-bottom: 16px;
        }
        #match-result-winner-row {
            font-size: 1.1em;
            margin-bottom: 16px;
        }
        #match-result-winner-label {
            color: #888;
            font-size: 0.9em;
            margin-right: 6px;
        }
        #match-result-winner-name {
            color: #f0f0f0;
            font-weight: bold;
        }
        #match-result-sets-table {
            margin: 0 auto 24px;
            border-collapse: collapse;
            min-width: 240px;
        }
        #match-result-sets-table th,
        #match-result-sets-table td {
            padding: 6px 14px;
            border-bottom: 1px solid #333;
            font-size: 0.9em;
        }
        #match-result-sets-table th {
            color: #777;
            font-weight: normal;
        }
        #match-result-sets-table td {
            color: #eee;
        }
        #next-match-btn {
            display: block;
            width: 80%;
            margin: 0 auto;
            padding: 14px 0;
            font-size: 1.1em;
            background: #2980b9;
            color: #fff;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }
        #version-info {
            margin-top: 40px;
            font-size: 0.65em;
            color: #444;
        }
    </style>
</head>
<body>
    <div id="page-wrapper">

        <div id="error-banner"></div>

        <h1>{{heading}}</h1>
        <div id="field-label">{{msgFieldLabel}} {{fieldNumber}}</div>

        <div id="status-msg">{{msgLoading}}</div>

        <div id="queue-status"></div>

        <!-- E06S07 AC3 / AC5: side swap notification -->
        <div id="swap-notification"></div>

        <!-- E06S06 AC9: no-match panel -->
        <div id="no-match-panel">{{msgNoMatch}}</div>

        <!-- E06S07 AC1: initial side selection panel -->
        <div id="side-selection-panel">
            <div id="side-selection-heading">{{msgSideSelectionHeading}}</div>
            <div id="side-selection-prompt">{{msgSideSelectionPrompt}}</div>

            <div id="side-preview">
                <div class="side-col">
                    <div class="side-col-label">{{msgSideLeft}}</div>
                    <div class="side-team-name" id="side-left-team"></div>
                </div>
                <span id="side-vs-label">{{msgVsLabel}}</span>
                <div class="side-col">
                    <div class="side-col-label">{{msgSideRight}}</div>
                    <div class="side-team-name" id="side-right-team"></div>
                </div>
            </div>

            <button id="side-swap-btn" type="button">{{msgSideSwap}}</button>
            <button id="match-start-btn" type="button">{{msgMatchStart}}</button>
        </div>

        <!-- E06S06 AC3 / E06S07: match display + score entry panel -->
        <div id="match-panel">

            <!-- E06S07 AC8: set counter -->
            <div id="set-counter-row"></div>

            <!-- AC3: team names row -->
            <div id="team-row">
                <span id="team1-name"></span>
                <span id="vs-label">{{msgVsLabel}}</span>
                <span id="team2-name"></span>
            </div>

            <!-- E06S07 AC9: side indicator row -->
            <div id="side-indicator-row">
                <span id="side-left-label"></span>
                &nbsp;&nbsp;&mdash;&nbsp;&nbsp;
                <span id="side-right-label"></span>
            </div>

            <!-- Lap and set info -->
            <div id="lap-set-row">
                <span id="lap-info"></span>
                &nbsp;&mdash;&nbsp;
                <span id="set-info"></span>
            </div>

            <!-- Referee row -->
            <div id="referee-row" style="display:none">
                {{msgRefereeLabel}}: <span id="referee-name"></span>
            </div>

            <!-- E06S07 AC4: manual side swap button -->
            <button id="match-swap-btn" type="button">{{msgSideSwap}}</button>

            <!-- AC3: score entry area -->
            <div id="score-area">
                <div class="score-col" id="col-team1">
                    <div class="score-col-label" id="label-team1"></div>
                    <div class="score-display" id="score-team1">0</div>
                    <button class="btn-plus"  id="plus-team1"  type="button">{{msgPlusLabel}}</button>
                    <button class="btn-minus" id="minus-team1" type="button">{{msgMinusLabel}}</button>
                    <input  class="score-input" id="input-team1" type="number" min="0" max="99" value="0">
                </div>

                <div class="score-col" id="col-team2">
                    <div class="score-col-label" id="label-team2"></div>
                    <div class="score-display" id="score-team2">0</div>
                    <button class="btn-plus"  id="plus-team2"  type="button">{{msgPlusLabel}}</button>
                    <button class="btn-minus" id="minus-team2" type="button">{{msgMinusLabel}}</button>
                    <input  class="score-input" id="input-team2" type="number" min="0" max="99" value="0">
                </div>
            </div>

            <!-- AC5: confirm set result button -->
            <button id="confirm-btn" type="button">{{msgConfirmHeading}}</button>

        </div><!-- /#match-panel -->

        <!-- E06S07 AC6: match result summary panel -->
        <div id="match-result-panel">
            <div id="match-result-heading">{{msgMatchResultHeading}}</div>
            <div id="match-result-winner-row">
                <span id="match-result-winner-label">{{msgMatchWinner}}:</span>
                <span id="match-result-winner-name"></span>
            </div>
            <table id="match-result-sets-table">
                <thead>
                    <tr>
                        <th>{{msgSetLabel}}</th>
                        <th id="result-team1-header"></th>
                        <th id="result-team2-header"></th>
                    </tr>
                </thead>
                <tbody id="match-result-sets-body">
                </tbody>
            </table>
            <button id="next-match-btn" type="button">{{msgNextMatch}}</button>
        </div>

        <div id="version-info">
            <small>{{versionLabel}}: {{appVersion}}</small>
        </div>

    </div><!-- /#page-wrapper -->

    <!-- E06S06 AC5: confirmation dialog overlay -->
    <div id="confirm-dialog">
        <div id="confirm-dialog-box">
            <div id="confirm-dialog-heading">{{msgConfirmHeading}}</div>
            <div id="confirm-dialog-prompt">{{msgConfirmPrompt}}</div>
            <div id="confirm-dialog-score"></div>
            <button class="confirm-dialog-btn" id="confirm-yes-btn" type="button">{{msgConfirmYes}}</button>
            <button class="confirm-dialog-btn" id="confirm-no-btn"  type="button">{{msgConfirmNo}}</button>
        </div>
    </div>

    <!--
        E06S02 AC4 (ES5 utility script) + DEC-19:
        Only the shared ES5 utility script and inline ES5 are permitted on this page.
        No npm-bundled code, no Svelte, no modern JS framework.
    -->
    <script src="/score/assets/vvwt-tablet.js"></script>

    <!--
        E06S06 + E06S07 inline ES5 multi-set scoring logic.
        DEC-19: ECMAScript 5 only — var, named functions, no arrow/class/template literals.

        E06S06 ACs (unchanged): AC1-AC13.
        E06S07 ACs (new): AC1 (side selection), AC2 (set progression), AC3 (auto swap),
          AC4 (manual swap), AC5 (tie-break swap), AC6 (result summary), AC7 (next match),
          AC8 (set counter), AC9 (side indicator), AC10 (state persistence), AC11-AC13.
    -->
    <script>
    /* =========================================================================
       E06S06 + E06S07 — Score-entry page ES5 inline script.
       DEC-19 constraint: ECMAScript 5 only.
       Relies on helpers from /score/assets/vvwt-tablet.js:
         vvwtFetch, vvwtSetText, vvwtShow, vvwtHide, vvwtQuery
       ========================================================================= */

    /* -------------------------------------------------------------------------
       i18n strings (AC13) — injected by Mustache controller
       --------------------------------------------------------------------- */
    var MSG_LOADING              = '{{msgLoading}}';
    var MSG_NO_MATCH             = '{{msgNoMatch}}';
    var MSG_ERROR_NET            = '{{msgErrorNet}}';
    var MSG_ERROR_TOKEN          = '{{msgErrorToken}}';
    var MSG_ERROR_FORBIDDEN      = '{{msgErrorForbidden}}';
    var MSG_ERROR_VALIDATION     = '{{msgErrorValidation}}';
    var MSG_SUBMIT_SUCCESS       = '{{msgSubmitSuccess}}';
    var MSG_QUEUE_PENDING        = '{{msgQueuePending}}';
    var MSG_QUEUE_SAVED          = '{{msgQueueSaved}}';
    var MSG_LAP_LABEL            = '{{msgLapLabel}}';
    var MSG_SET_LABEL            = '{{msgSetLabel}}';
    /* E06S07 AC13 */
    var MSG_SWAP_NOTIFICATION    = '{{msgSwapNotification}}';
    var MSG_SWAP_TIEBREAK        = '{{msgSwapTiebreak}}';
    var MSG_SET_COUNTER          = '{{msgSetCounter}}';
    var MSG_COURT_LEFT           = '{{msgCourtLeft}}';
    var MSG_COURT_RIGHT          = '{{msgCourtRight}}';
    var MSG_MATCH_WINNER         = '{{msgMatchWinner}}';
    var MSG_MATCH_STANDOFF       = '{{msgMatchStandoff}}';
    var MSG_NEXT_MATCH_LOADING   = '{{msgNextMatchLoading}}';

    /* -------------------------------------------------------------------------
       Page state
       --------------------------------------------------------------------- */
    var FIELD_NUMBER             = {{fieldNumber}};
    var TOKEN_STORAGE_KEY        = 'vvwt_device_token';
    var TOKEN_COOKIE_NAME        = 'vvwt_device_token';

    /* Current match state */
    var currentMatchId           = null;
    var currentSetIndex          = 0;
    var score1                   = 0;
    var score2                   = 0;

    /* Global team names for side swap display (AC3, AC9) */
    var gTeam1Name               = '';
    var gTeam2Name               = '';

    /* E06S07 multi-set state */
    var matchStarted             = false;   /* AC1: true once "Start match" pressed */
    var sideSwapped              = false;   /* AC3/AC4: false=team1 left, true=team1 right */
    var tiebreakSwapDone         = false;   /* AC5: prevent double-firing per set */
    var matchMaxSets             = 1;
    var matchFormatName          = 'BEST_OF_1';
    var tiebreakThreshold        = 8;
    var team1SetsWon             = 0;
    var team2SetsWon             = 0;
    var matchDecided             = false;
    var matchWinner              = null;
    /* Set results stored for summary display: index = setIndex, value = {t1,t2} */
    var setResultsForSummary     = [];

    /* E06S06 AC11: offline score queue */
    var scoreQueue               = [];

    /* -------------------------------------------------------------------------
       DOM references
       --------------------------------------------------------------------- */
    var elErrorBanner             = vvwtQuery('#error-banner');
    var elStatusMsg               = vvwtQuery('#status-msg');
    var elQueueStatus             = vvwtQuery('#queue-status');
    var elSwapNotification        = vvwtQuery('#swap-notification');
    var elNoMatchPanel            = vvwtQuery('#no-match-panel');
    var elSideSelectionPanel      = vvwtQuery('#side-selection-panel');
    var elSideLeftTeam            = vvwtQuery('#side-left-team');
    var elSideRightTeam           = vvwtQuery('#side-right-team');
    var elSideSwapBtn             = vvwtQuery('#side-swap-btn');
    var elMatchStartBtn           = vvwtQuery('#match-start-btn');
    var elMatchPanel              = vvwtQuery('#match-panel');
    var elSetCounterRow           = vvwtQuery('#set-counter-row');
    var elTeam1Name               = vvwtQuery('#team1-name');
    var elTeam2Name               = vvwtQuery('#team2-name');
    var elSideLeftLabel           = vvwtQuery('#side-left-label');
    var elSideRightLabel          = vvwtQuery('#side-right-label');
    var elLapInfo                 = vvwtQuery('#lap-info');
    var elSetInfo                 = vvwtQuery('#set-info');
    var elRefereeRow              = vvwtQuery('#referee-row');
    var elRefereeName             = vvwtQuery('#referee-name');
    var elMatchSwapBtn            = vvwtQuery('#match-swap-btn');
    var elLabelTeam1              = vvwtQuery('#label-team1');
    var elLabelTeam2              = vvwtQuery('#label-team2');
    var elScoreTeam1              = vvwtQuery('#score-team1');
    var elScoreTeam2              = vvwtQuery('#score-team2');
    var elPlusTeam1               = vvwtQuery('#plus-team1');
    var elMinusTeam1              = vvwtQuery('#minus-team1');
    var elInputTeam1              = vvwtQuery('#input-team1');
    var elPlusTeam2               = vvwtQuery('#plus-team2');
    var elMinusTeam2              = vvwtQuery('#minus-team2');
    var elInputTeam2              = vvwtQuery('#input-team2');
    var elConfirmBtn              = vvwtQuery('#confirm-btn');
    var elConfirmDialog           = vvwtQuery('#confirm-dialog');
    var elConfirmScore            = vvwtQuery('#confirm-dialog-score');
    var elConfirmYesBtn           = vvwtQuery('#confirm-yes-btn');
    var elConfirmNoBtn            = vvwtQuery('#confirm-no-btn');
    var elMatchResultPanel        = vvwtQuery('#match-result-panel');
    var elMatchResultWinnerName   = vvwtQuery('#match-result-winner-name');
    var elResultTeam1Header       = vvwtQuery('#result-team1-header');
    var elResultTeam2Header       = vvwtQuery('#result-team2-header');
    var elMatchResultSetsBody     = vvwtQuery('#match-result-sets-body');
    var elNextMatchBtn            = vvwtQuery('#next-match-btn');

    /* -------------------------------------------------------------------------
       AC10 (E06S06): Token storage helpers
       --------------------------------------------------------------------- */

    function localStorageGet(key) {
        try { return window.localStorage ? window.localStorage.getItem(key) : null; }
        catch (e) { return null; }
    }

    function cookieGet(name) {
        var cookies = document.cookie ? document.cookie.split(';') : [];
        for (var i = 0; i < cookies.length; i++) {
            var parts = cookies[i].split('=');
            var n = (parts[0] || '').replace(/^\s+|\s+$/g, '');
            if (n === name) {
                return decodeURIComponent((parts[1] || '').replace(/^\s+|\s+$/g, ''));
            }
        }
        return null;
    }

    function retrieveToken() {
        var t = localStorageGet(TOKEN_STORAGE_KEY);
        if (t) { return t; }
        return cookieGet(TOKEN_COOKIE_NAME);
    }

    /* -------------------------------------------------------------------------
       Score display helpers
       --------------------------------------------------------------------- */

    function updateScoreDisplay() {
        vvwtSetText(elScoreTeam1, String(score1));
        vvwtSetText(elScoreTeam2, String(score2));
        if (elInputTeam1) { elInputTeam1.value = String(score1); }
        if (elInputTeam2) { elInputTeam2.value = String(score2); }
    }

    /* -------------------------------------------------------------------------
       E06S07 AC8: Set counter display
       --------------------------------------------------------------------- */

    function updateSetCounterDisplay() {
        var displaySet = currentSetIndex + 1;
        var counterText = MSG_SET_COUNTER
                .replace('{0}', String(displaySet))
                .replace('{1}', String(matchMaxSets));
        vvwtSetText(elSetCounterRow, counterText);
    }

    /* -------------------------------------------------------------------------
       E06S07 AC9: Side indicator update
       --------------------------------------------------------------------- */

    function updateSideIndicators() {
        var leftName  = sideSwapped ? gTeam2Name : gTeam1Name;
        var rightName = sideSwapped ? gTeam1Name : gTeam2Name;
        vvwtSetText(elSideLeftLabel,  MSG_COURT_LEFT  + ': ' + leftName);
        vvwtSetText(elSideRightLabel, MSG_COURT_RIGHT + ': ' + rightName);
    }

    /* -------------------------------------------------------------------------
       E06S07 AC1: Side selection preview update
       --------------------------------------------------------------------- */

    function updateSidePreview() {
        var leftName  = sideSwapped ? gTeam2Name : gTeam1Name;
        var rightName = sideSwapped ? gTeam1Name : gTeam2Name;
        vvwtSetText(elSideLeftTeam,  leftName);
        vvwtSetText(elSideRightTeam, rightName);
    }

    /* -------------------------------------------------------------------------
       E06S07 AC3 / AC4 / AC5: Side swap helper
       --------------------------------------------------------------------- */

    function performSideSwap(showNotification, notificationMsg) {
        sideSwapped = !sideSwapped;
        updateSideIndicators();
        if (showNotification && elSwapNotification) {
            vvwtSetText(elSwapNotification, notificationMsg);
            vvwtShow(elSwapNotification);
            window.setTimeout(function () {
                vvwtHide(elSwapNotification);
            }, 3000);
        }
    }

    /* -------------------------------------------------------------------------
       E06S07 AC5: Tie-break side swap detection
       Called on score change when in the deciding set.
       --------------------------------------------------------------------- */

    function checkTiebreakSwap() {
        if (matchFormatName === 'BEST_OF_1' || matchFormatName === 'FIXED_2_SETS') {
            return;
        }
        var decidingSetIndex = matchMaxSets - 1;
        if (currentSetIndex !== decidingSetIndex) {
            return;
        }
        if (tiebreakSwapDone) {
            return;
        }
        if (score1 >= tiebreakThreshold || score2 >= tiebreakThreshold) {
            tiebreakSwapDone = true;
            var msg = MSG_SWAP_TIEBREAK.replace('{0}', String(tiebreakThreshold));
            performSideSwap(true, msg);
        }
    }

    /* -------------------------------------------------------------------------
       E06S06 AC5: Partial score broadcast
       --------------------------------------------------------------------- */

    function sendPartialScore() {
        var token = retrieveToken();
        if (!token || !currentMatchId) { return; }

        vvwtFetch(
            '/api/score/partial',
            {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    matchId:     currentMatchId,
                    setIndex:    currentSetIndex,
                    team1Points: score1,
                    team2Points: score2,
                    deviceToken: token
                })
            },
            function () { /* partial is fire-and-forget */ },
            function (err) {
                if (window.console && window.console.warn) {
                    window.console.warn('[E06S06] Partial score error: ' + err);
                }
            }
        );
    }

    /* -------------------------------------------------------------------------
       E06S06 AC4: +/- button and input handlers
       --------------------------------------------------------------------- */

    function clamp(val) {
        if (val < 0)  { return 0; }
        if (val > 99) { return 99; }
        return val;
    }

    if (elPlusTeam1) {
        elPlusTeam1.onclick = function () {
            score1 = clamp(score1 + 1);
            updateScoreDisplay();
            sendPartialScore();
            checkTiebreakSwap();
        };
    }
    if (elMinusTeam1) {
        elMinusTeam1.onclick = function () {
            score1 = clamp(score1 - 1);
            updateScoreDisplay();
            sendPartialScore();
        };
    }
    if (elPlusTeam2) {
        elPlusTeam2.onclick = function () {
            score2 = clamp(score2 + 1);
            updateScoreDisplay();
            sendPartialScore();
            checkTiebreakSwap();
        };
    }
    if (elMinusTeam2) {
        elMinusTeam2.onclick = function () {
            score2 = clamp(score2 - 1);
            updateScoreDisplay();
            sendPartialScore();
        };
    }
    if (elInputTeam1) {
        elInputTeam1.onchange = function () {
            var v = parseInt(elInputTeam1.value, 10);
            score1 = isNaN(v) ? 0 : clamp(v);
            updateScoreDisplay();
            sendPartialScore();
            checkTiebreakSwap();
        };
    }
    if (elInputTeam2) {
        elInputTeam2.onchange = function () {
            var v = parseInt(elInputTeam2.value, 10);
            score2 = isNaN(v) ? 0 : clamp(v);
            updateScoreDisplay();
            sendPartialScore();
            checkTiebreakSwap();
        };
    }

    /* -------------------------------------------------------------------------
       E06S07 AC1: Initial side selection handlers
       --------------------------------------------------------------------- */

    if (elSideSwapBtn) {
        elSideSwapBtn.onclick = function () {
            sideSwapped = !sideSwapped;
            updateSidePreview();
        };
    }

    if (elMatchStartBtn) {
        elMatchStartBtn.onclick = function () {
            matchStarted = true;
            vvwtHide(elSideSelectionPanel);
            openMatchScoringPanel();
        };
    }

    /* -------------------------------------------------------------------------
       E06S07 AC4: Manual side swap during match
       --------------------------------------------------------------------- */

    if (elMatchSwapBtn) {
        elMatchSwapBtn.onclick = function () {
            performSideSwap(false, '');
        };
    }

    /* -------------------------------------------------------------------------
       E06S06 AC5, AC7: Confirm dialog
       --------------------------------------------------------------------- */

    if (elConfirmBtn) {
        elConfirmBtn.onclick = function () {
            if (elConfirmScore) {
                vvwtSetText(elConfirmScore, score1 + ' : ' + score2);
            }
            vvwtShow(elConfirmDialog);
        };
    }

    if (elConfirmNoBtn) {
        elConfirmNoBtn.onclick = function () {
            vvwtHide(elConfirmDialog);
        };
    }

    if (elConfirmYesBtn) {
        elConfirmYesBtn.onclick = function () {
            vvwtHide(elConfirmDialog);
            submitSetResult(score1, score2);
        };
    }

    /* -------------------------------------------------------------------------
       E06S06 AC7, AC11 / E06S07 AC2: Set result submission
       After success: re-poll server. If matchDecided=false, advance to next set.
       --------------------------------------------------------------------- */

    function submitSetResult(t1, t2) {
        var token = retrieveToken();
        if (!token) {
            showError(MSG_ERROR_TOKEN);
            return;
        }
        if (!currentMatchId) {
            return;
        }

        showQueueStatus(MSG_QUEUE_PENDING);

        vvwtFetch(
            '/api/score/submit',
            {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    matchId:     currentMatchId,
                    setIndex:    currentSetIndex,
                    team1Points: t1,
                    team2Points: t2,
                    deviceToken: token
                })
            },
            function () {
                /* Success: store result for summary, reload match state (AC2) */
                scoreQueue = [];
                setResultsForSummary[currentSetIndex] = { t1: t1, t2: t2 };
                showQueueStatus(MSG_QUEUE_SAVED);
                vvwtSetText(elStatusMsg, MSG_SUBMIT_SUCCESS);
                window.setTimeout(function () {
                    loadMatch();
                }, 1200);
            },
            function (err) {
                hideQueueStatus();
                if (err && err.indexOf('401') !== -1) {
                    showError(MSG_ERROR_TOKEN);
                } else if (err && err.indexOf('403') !== -1) {
                    showError(MSG_ERROR_FORBIDDEN);
                } else if (err && err.indexOf('400') !== -1) {
                    /* AC11 (E06S06): validation error — stay on current set (E06S07 AC11) */
                    showError(MSG_ERROR_VALIDATION);
                } else {
                    /* AC11 (E06S06): network error — queue for retry */
                    scoreQueue.push({
                        matchId:     currentMatchId,
                        setIndex:    currentSetIndex,
                        team1Points: t1,
                        team2Points: t2
                    });
                    showError(MSG_ERROR_NET);
                }
            }
        );
    }

    function showQueueStatus(msg) {
        if (elQueueStatus) {
            vvwtSetText(elQueueStatus, msg);
            vvwtShow(elQueueStatus);
        }
    }

    function hideQueueStatus() {
        if (elQueueStatus) { vvwtHide(elQueueStatus); }
    }

    /* -------------------------------------------------------------------------
       Error helpers
       --------------------------------------------------------------------- */

    function showError(message) {
        if (elErrorBanner) {
            vvwtSetText(elErrorBanner, message);
            vvwtShow(elErrorBanner);
        }
        vvwtSetText(elStatusMsg, '');
    }

    function clearError() {
        if (elErrorBanner) { vvwtHide(elErrorBanner); }
    }

    /* -------------------------------------------------------------------------
       E06S07 AC6: Match result summary panel
       --------------------------------------------------------------------- */

    function showMatchResultPanel(data) {
        vvwtHide(elMatchPanel);
        vvwtHide(elSideSelectionPanel);

        /* Determine winner display name */
        var winnerDisplay;
        if (data.matchWinner === 'TEAM1') {
            winnerDisplay = gTeam1Name;
        } else if (data.matchWinner === 'TEAM2') {
            winnerDisplay = gTeam2Name;
        } else {
            winnerDisplay = MSG_MATCH_STANDOFF;
        }
        vvwtSetText(elMatchResultWinnerName, winnerDisplay);

        /* Table headers */
        vvwtSetText(elResultTeam1Header, gTeam1Name);
        vvwtSetText(elResultTeam2Header, gTeam2Name);

        /* Set rows from accumulated results */
        if (elMatchResultSetsBody) {
            elMatchResultSetsBody.innerHTML = '';
            var totalCompletedSets = (data.team1SetsWon || 0) + (data.team2SetsWon || 0);
            for (var i = 0; i < totalCompletedSets; i++) {
                var tr = document.createElement('tr');
                var tdSet = document.createElement('td');
                var tdT1  = document.createElement('td');
                var tdT2  = document.createElement('td');
                vvwtSetText(tdSet, String(i + 1));
                var sr = setResultsForSummary[i] || { t1: '-', t2: '-' };
                vvwtSetText(tdT1, String(sr.t1));
                vvwtSetText(tdT2, String(sr.t2));
                tr.appendChild(tdSet);
                tr.appendChild(tdT1);
                tr.appendChild(tdT2);
                elMatchResultSetsBody.appendChild(tr);
            }
        }

        vvwtSetText(elStatusMsg, '');
        vvwtShow(elMatchResultPanel);
    }

    /* -------------------------------------------------------------------------
       E06S07 AC7: Next match navigation
       --------------------------------------------------------------------- */

    if (elNextMatchBtn) {
        elNextMatchBtn.onclick = function () {
            vvwtSetText(elStatusMsg, MSG_NEXT_MATCH_LOADING);
            vvwtHide(elMatchResultPanel);
            resetMatchState();
            loadMatch();
        };
    }

    function resetMatchState() {
        currentMatchId        = null;
        currentSetIndex       = 0;
        score1                = 0;
        score2                = 0;
        gTeam1Name            = '';
        gTeam2Name            = '';
        matchStarted          = false;
        sideSwapped           = false;
        tiebreakSwapDone      = false;
        matchMaxSets          = 1;
        matchFormatName       = 'BEST_OF_1';
        tiebreakThreshold     = 8;
        team1SetsWon          = 0;
        team2SetsWon          = 0;
        matchDecided          = false;
        matchWinner           = null;
        setResultsForSummary  = [];
        scoreQueue            = [];
    }

    /* -------------------------------------------------------------------------
       Open match scoring panel (after initial side selection or set advance)
       --------------------------------------------------------------------- */

    function openMatchScoringPanel() {
        /* AC3: auto swap when advancing between sets (but not for the first set) */
        if (matchStarted && currentSetIndex > 0) {
            /* Only swap on set advancement, not on re-entry to same set index */
            /* The swap already happened in onSetAdvance — this is just for display */
        }
        updateSetCounterDisplay();
        updateSideIndicators();
        vvwtShow(elMatchPanel);
    }

    /* -------------------------------------------------------------------------
       E06S06 AC1, AC4 / E06S07: Load and display the active match
       --------------------------------------------------------------------- */

    /**
     * Load the active match for this field via GET /api/score/match.
     * AC9: 204 No Content or empty → no-match panel.
     * E06S07 AC2: after submit, reload to detect match-decided or advance to next set.
     * E06S07 AC10: full server response enables state restoration on refresh.
     */
    function loadMatch() {
        var token = retrieveToken();
        clearError();
        vvwtHide(elSwapNotification);
        vvwtShow(elStatusMsg);
        vvwtSetText(elStatusMsg, MSG_LOADING);
        vvwtHide(elMatchPanel);
        vvwtHide(elSideSelectionPanel);
        vvwtHide(elNoMatchPanel);
        vvwtHide(elMatchResultPanel);

        if (!token) {
            showError(MSG_ERROR_TOKEN);
            return;
        }

        vvwtFetch(
            '/api/score/match?field=' + FIELD_NUMBER + '&token=' + encodeURIComponent(token),
            { method: 'GET' },
            function (data) {
                vvwtSetText(elStatusMsg, '');
                if (!data) {
                    currentMatchId = null;
                    vvwtShow(elNoMatchPanel);
                    return;
                }
                renderMatch(data);
            },
            function (err) {
                if (err && err.indexOf('401') !== -1) {
                    showError(MSG_ERROR_TOKEN);
                } else if (err && err.indexOf('403') !== -1) {
                    showError(MSG_ERROR_FORBIDDEN);
                } else if (err && err.indexOf('204') !== -1) {
                    currentMatchId = null;
                    vvwtSetText(elStatusMsg, '');
                    vvwtShow(elNoMatchPanel);
                } else {
                    showError(MSG_ERROR_NET);
                }
            }
        );
    }

    /**
     * Render match state from server response.
     * Handles all phases: initial side selection, active scoring, set advance, match end.
     */
    function renderMatch(data) {
        var incomingMatchId = (data.matchId || '').toString();
        var isNewMatch = (currentMatchId === null || currentMatchId.toString() !== incomingMatchId);
        var previousSetIndex = currentSetIndex;

        /* Update state from server response (AC10: full restoration on refresh) */
        currentMatchId    = data.matchId   || null;
        currentSetIndex   = data.setIndex  || 0;
        score1            = data.team1Points || 0;
        score2            = data.team2Points || 0;
        matchMaxSets      = data.maxSets   || 1;
        matchFormatName   = data.matchFormat || 'BEST_OF_1';
        tiebreakThreshold = data.tiebreakSwapThreshold || 8;
        team1SetsWon      = data.team1SetsWon || 0;
        team2SetsWon      = data.team2SetsWon || 0;
        matchDecided      = data.matchDecided  || false;
        matchWinner       = data.matchWinner   || null;

        gTeam1Name = data.team1Name || '?';
        gTeam2Name = data.team2Name || '?';

        /* Reset tie-break swap flag when a new match begins or when set advances */
        if (isNewMatch) {
            tiebreakSwapDone = false;
            matchStarted     = false;
            sideSwapped      = false;
        } else if (currentSetIndex !== previousSetIndex) {
            /* E06S07 AC3: auto swap between sets */
            tiebreakSwapDone = false;
            performSideSwap(true, MSG_SWAP_NOTIFICATION);
        }

        /* E06S07 AC6: show result summary when match is decided */
        if (matchDecided) {
            showMatchResultPanel(data);
            return;
        }

        /* Update team names display */
        vvwtSetText(elTeam1Name, gTeam1Name);
        vvwtSetText(elTeam2Name, gTeam2Name);
        vvwtSetText(elLabelTeam1, gTeam1Name);
        vvwtSetText(elLabelTeam2, gTeam2Name);

        /* Lap and set info */
        vvwtSetText(elLapInfo, MSG_LAP_LABEL + ' ' + (data.lapNumber || 0));
        vvwtSetText(elSetInfo, MSG_SET_LABEL + ' ' + (currentSetIndex + 1));

        /* Referee */
        if (data.refereeTeamName) {
            vvwtSetText(elRefereeName, data.refereeTeamName);
            vvwtShow(elRefereeRow);
        } else {
            vvwtHide(elRefereeRow);
        }

        /* Score display */
        updateScoreDisplay();

        /* Retry queued submissions (AC11) */
        if (scoreQueue.length > 0) {
            var queued = scoreQueue.shift();
            submitSetResult(queued.team1Points, queued.team2Points);
            return;
        }

        /* E06S07 AC1: show initial side selection if match not yet started */
        if (!matchStarted) {
            updateSidePreview();
            vvwtShow(elSideSelectionPanel);
            return;
        }

        /* Show match scoring panel */
        openMatchScoringPanel();
    }

    /* -------------------------------------------------------------------------
       Page init — load match on startup
       --------------------------------------------------------------------- */
    (function init() {
        loadMatch();
    }());

    </script>
</body>
</html>
