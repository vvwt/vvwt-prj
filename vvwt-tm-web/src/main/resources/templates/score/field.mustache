<!DOCTYPE html>
<html lang="{{locale}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <!-- E44S02 AC3: VVW blue hex-icon favicon links — SVG first, PNG largest-to-smallest (AC7) -->
    <link rel="icon" type="image/svg+xml" href="/score/vvw-icon-blue.svg">
    <link rel="icon" type="image/png" sizes="256x256" href="/score/vvw-favicon-blue-256.png">
    <link rel="icon" type="image/png" sizes="128x128" href="/score/vvw-favicon-blue-128.png">
    <link rel="icon" type="image/png" sizes="64x64" href="/score/vvw-favicon-blue-64.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/score/vvw-favicon-blue-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/score/vvw-favicon-blue-16.png">
    <style>
        /*
         * E61S01 — Redesigned score entry page styles.
         * iOS 9 Safari compatible: no flexbox/grid quirks, no CSS container queries.
         * DEC-19: scoring tablet surface; Mustache + ES5 only.
         */
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            font-size: 18px;
            background: #1a1a2e;
            color: #eee;
            text-align: center;
        }
        /* AC2: field-page header — match identity (teams + round/set) */
        #field-header {
            background: #16163a;
            border-bottom: 1px solid #333;
            padding: 10px 16px;
            min-height: 48px;
        }
        #header-teams {
            display: block;
            font-size: 1.1em;
            font-weight: bold;
            color: #f0f0f0;
        }
        #header-round-set {
            display: block;
            font-size: 0.8em;
            color: #888;
            margin-top: 2px;
        }
        #page-wrapper {
            padding: 16px 16px 120px;
            max-width: 540px;
            margin: 0 auto;
        }
        /* AC8: global error banner.
         * E49S03 M-C: initial hide via inline style="display:none" on the element. */
        #error-banner {
            background: #c0392b;
            color: #fff;
            padding: 12px 16px;
            margin-bottom: 16px;
            border-radius: 4px;
            font-size: 0.9em;
        }
        /* Status / loading message */
        #status-msg {
            font-size: 0.95em;
            color: #777;
            margin-bottom: 20px;
            min-height: 1.4em;
        }
        /* AC9: no-match panel.
         * E49S03 M-C: initial hide via inline style="display:none". */
        #no-match-panel {
            padding: 32px 16px;
            color: #666;
            font-size: 1em;
        }
        /* AC3, AC5: match display panel */
        #match-panel {
        }
        /* AC5: score entry area — single field per team */
        #score-area {
            margin-bottom: 28px;
        }
        .score-col {
            display: inline-block;
            width: 45%;
            vertical-align: top;
        }
        .score-col-label {
            font-size: 0.8em;
            color: #888;
            margin-bottom: 8px;
        }
        /* AC5: single large editable score input (replaces separate display + small input) */
        .score-input {
            display: block;
            width: 90%;
            margin: 0 auto 10px;
            font-size: 3.5em;
            font-weight: bold;
            text-align: center;
            padding: 12px 4px;
            background: #2d2d54;
            color: #fff;
            border: 2px solid #444;
            border-radius: 8px;
        }
        /* AC3, AC9: +/- buttons */
        .btn-plus, .btn-minus {
            display: inline-block;
            width: 44%;
            padding: 10px 0;
            font-size: 1.4em;
            font-weight: bold;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            margin: 2px 1%;
        }
        .btn-plus  { background: #27ae60; color: #fff; }
        .btn-minus { background: #7f8c8d; color: #fff; }
        /* AC5: confirm button */
        #confirm-btn {
            display: block;
            width: 90%;
            margin: 0 auto 20px;
            padding: 14px 0;
            font-size: 1.1em;
            background: #2980b9;
            color: #fff;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }
        /* AC11: queue status pill */
        #queue-status {
            font-size: 0.75em;
            color: #888;
            margin-bottom: 12px;
        }
        /* AC5: confirmation dialog overlay */
        #confirm-dialog {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.7);
            z-index: 100;
        }
        #confirm-dialog-box {
            background: #22224a;
            border-radius: 10px;
            padding: 32px 24px 24px;
            margin: 18% auto 0;
            max-width: 380px;
            width: 90%;
        }
        #confirm-dialog-heading {
            font-size: 1.1em;
            color: #eee;
            margin-bottom: 10px;
        }
        #confirm-dialog-prompt {
            font-size: 0.95em;
            color: #aaa;
            margin-bottom: 24px;
        }
        #confirm-dialog-score {
            font-size: 2em;
            font-weight: bold;
            color: #fff;
            margin-bottom: 24px;
        }
        .confirm-dialog-btn {
            display: inline-block;
            width: 44%;
            margin: 0 2%;
            padding: 12px 0;
            font-size: 1em;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }
        #confirm-yes-btn { background: #27ae60; color: #fff; }
        #confirm-no-btn  { background: #555; color: #eee; }
        /* AC1 (E61S03): swap control button */
        #swap-btn {
            display: block;
            width: 90%;
            margin: 0 auto 20px;
            padding: 10px 0;
            font-size: 0.95em;
            background: #444466;
            color: #ccc;
            border: 1px solid #555;
            border-radius: 6px;
            cursor: pointer;
        }
        /* AC3, AC4: bottom bar — fixed at page bottom */
        #bottom-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 8px 16px;
            background: #0e0e22;
            border-top: 1px solid #222;
        }
        /* AC3: bottom-left wordmark */
        #bottom-wordmark {
            position: absolute;
            left: 16px;
            bottom: 8px;
            font-size: 0.7em;
            color: #555;
            white-space: nowrap;
        }
        #bottom-wordmark img.icon-o {
            width: 10px;
            height: 10px;
            vertical-align: middle;
        }
        /* AC4: bottom-centre field number */
        #bottom-field-number {
            display: inline-block;
            font-size: 0.75em;
            color: #555;
        }
        /* Version info */
        #version-info {
            font-size: 0.6em;
            color: #3a3a5a;
            display: block;
            margin-top: 2px;
        }
    </style>
</head>
<body>
    <!-- AC2: field-page header — match identity (teams + round/set), populated by JS -->
    <div id="field-header">
        <span id="header-teams"></span>
        <span id="header-round-set"></span>
    </div>

    <div id="page-wrapper">

        <!-- AC8: global error banner.
             E49S03 M-C: inline style="display:none" for vvwtShow compatibility. -->
        <div id="error-banner" style="display:none"></div>

        <!-- Status / loading line -->
        <div id="status-msg">{{msgLoading}}</div>

        <!-- AC11: score queue status.
             E49S03 M-C: inline style="display:none" for vvwtShow compatibility. -->
        <div id="queue-status" style="display:none"></div>

        <!-- AC9: no-match panel — shown when no active match on this field.
             E49S03 M-C: inline style="display:none" for vvwtShow compatibility. -->
        <div id="no-match-panel" style="display:none">{{msgNoMatch}}</div>

        <!-- AC5: match display + score entry panel.
             E49S03 M-C: inline style="display:none" for vvwtShow compatibility. -->
        <div id="match-panel" style="display:none">

            <!-- Referee row (shown only if referee present) -->
            <div id="referee-row" style="display:none">
                {{msgRefereeLabel}}: <span id="referee-name"></span>
            </div>

            <!-- AC5: score entry area — single editable field per team -->
            <div id="score-area">
                <!-- Team 1 column -->
                <div class="score-col" id="col-team1">
                    <div class="score-col-label" id="label-team1"></div>
                    <!-- AC5: single large editable input (replaces score-display + small input) -->
                    <input class="score-input" id="input-team1" type="number" min="0" max="99"
                           value="0">
                    <!-- AC9: +/- buttons operate on input-team1 -->
                    <button class="btn-plus"  id="plus-team1"  type="button">{{msgPlusLabel}}</button>
                    <button class="btn-minus" id="minus-team1" type="button">{{msgMinusLabel}}</button>
                </div>

                <!-- Team 2 column -->
                <div class="score-col" id="col-team2">
                    <div class="score-col-label" id="label-team2"></div>
                    <!-- AC5: single large editable input (replaces score-display + small input) -->
                    <input class="score-input" id="input-team2" type="number" min="0" max="99"
                           value="0">
                    <!-- AC9: +/- buttons operate on input-team2 -->
                    <button class="btn-plus"  id="plus-team2"  type="button">{{msgPlusLabel}}</button>
                    <button class="btn-minus" id="minus-team2" type="button">{{msgMinusLabel}}</button>
                </div>
            </div><!-- /#score-area -->

            <!-- AC5: confirm set result button -->
            <button id="confirm-btn" type="button">{{msgConfirmHeading}}</button>

            <!-- AC1 (E61S03): manual swap control — swaps on-screen left/right team positions -->
            <button id="swap-btn" type="button">{{msgSwapLabel}}</button>

        </div><!-- /#match-panel -->

    </div><!-- /#page-wrapper -->

    <!-- AC5: confirmation dialog overlay.
         E49S03 M-C: inline style="display:none" for vvwtShow compatibility. -->
    <div id="confirm-dialog" style="display:none">
        <div id="confirm-dialog-box">
            <div id="confirm-dialog-heading">{{msgConfirmHeading}}</div>
            <div id="confirm-dialog-prompt">{{msgConfirmPrompt}}</div>
            <div id="confirm-dialog-score"></div>
            <button class="confirm-dialog-btn" id="confirm-yes-btn" type="button">{{msgConfirmYes}}</button>
            <button class="confirm-dialog-btn" id="confirm-no-btn"  type="button">{{msgConfirmNo}}</button>
        </div>
    </div>

    <!-- AC3, AC4: bottom bar — fixed at page bottom -->
    <div id="bottom-bar">
        <!-- AC3: bottom-left "Scoring Tablet" wordmark — letter 'o' as vvw-icon-blue.svg inline -->
        <div id="bottom-wordmark">Sc<img src="/score/vvw-icon-blue.svg" alt="o" class="icon-o">ring Tablet &nbsp;{{versionLabel}}: {{appVersion}}</div>
        <!-- AC4: bottom-centre field number — "Feld {n}" using existing i18n key (AC7) -->
        <div id="bottom-field-number">{{msgFieldLabel}} {{fieldNumber}}</div>
        <span id="version-info"></span>
    </div>

    <!--
        E06S02 AC4 (ES5 utility script) + DEC-19:
        Only the shared ES5 utility script and inline ES5 are permitted on this page.
        No npm-bundled code, no Svelte, no modern JS framework.
    -->
    <script src="/score/assets/vvwt-tablet.js"></script>

    <!--
        E61S01 inline ES5 score-entry logic — redesigned.
        E61S03 — team-position swap logic added.
        AC1:  Logo lockup removed (E61S01); swap control button added (E61S03).
        AC2:  Header shows active match identity (teams + round/set) — JS-populated.
        AC3:  Bottom-left wordmark rendered in template.
        AC4:  Bottom-centre field number rendered in template.
        AC5:  Single editable score input per team; +/- buttons operate on it.
        AC6:  When no active match, header spans are empty (no stale text).
        AC7:  All strings from i18n message keys (incl. score.field.swap.label, E61S03 AC8).
        AC8:  ECMAScript 5 only (DEC-19).
        AC9:  +/- buttons increment/decrement the single score input.
        E61S03 swap model: effectiveSwap = (deterministicSwap(setIndex, isTiebreak, pts) + swapOffset) % 2.
        deterministicSwap = setIndex%2 XOR tiebreak-8-point-switch. swapOffset from localStorage.
        DEC-19: ECMAScript 5 only — var, named functions, no arrow/class/template literals.
    -->
    <script>
    /* =========================================================================
       E61S01 — Score-entry page ES5 inline script (redesigned).
       E61S03 — Team-position swap added (AC1–AC10).
       DEC-19 constraint: ECMAScript 5 only.
       Relies on helpers from /score/assets/vvwt-tablet.js (must load first):
         vvwtFetch, vvwtSetText, vvwtShow, vvwtHide, vvwtQuery
       ========================================================================= */

    /* -------------------------------------------------------------------------
       i18n strings (AC7) — injected by Mustache controller
       --------------------------------------------------------------------- */
    var MSG_LOADING          = '{{msgLoading}}';
    var MSG_NO_MATCH         = '{{msgNoMatch}}';
    var MSG_ERROR_NET        = '{{msgErrorNet}}';
    var MSG_ERROR_TOKEN      = '{{msgErrorToken}}';
    var MSG_ERROR_FORBIDDEN  = '{{msgErrorForbidden}}';
    var MSG_ERROR_VALIDATION = '{{msgErrorValidation}}';
    var MSG_SUBMIT_SUCCESS   = '{{msgSubmitSuccess}}';
    var MSG_QUEUE_PENDING    = '{{msgQueuePending}}';
    var MSG_QUEUE_SAVED      = '{{msgQueueSaved}}';
    var MSG_LAP_LABEL        = '{{msgLapLabel}}';
    var MSG_SET_LABEL        = '{{msgSetLabel}}';
    var MSG_VS_LABEL         = '{{msgVsLabel}}';
    var MSG_SWAP_LABEL       = '{{msgSwapLabel}}';

    /* -------------------------------------------------------------------------
       Page state
       --------------------------------------------------------------------- */
    var FIELD_NUMBER         = {{fieldNumber}};
    var TOKEN_STORAGE_KEY    = 'vvwt_device_token';
    var TOKEN_COOKIE_NAME    = 'vvwt_device_token';

    /* Current match state */
    var currentMatchId       = null;
    var currentSetIndex      = 0;
    var currentIsTiebreak    = false;
    var currentTeam1Points   = 0;
    var currentTeam2Points   = 0;
    var score1               = 0;
    var score2               = 0;

    /* AC11: offline score queue — array of {matchId, setIndex, team1Points, team2Points} */
    var scoreQueue           = [];

    /* -------------------------------------------------------------------------
       AC1, AC4, AC6 (E61S03): Swap state — relative-toggle model.
       swapOffset (0 or 1) is the manual-swap component, persisted in localStorage.
       The deterministic component (per-set alternation + tiebreak 8-point switch)
       is recomputed each render from the API state (setIndex, isTiebreak, points).
       The effective swap = (deterministicSwap(setIndex, isTiebreak, points) + swapOffset) % 2.
       When effectiveSwap === 1, team2 appears on the left, team1 on the right.
       This is PURELY presentation — the score-team binding (AC5) is unchanged:
       score1 always belongs to team1, score2 to team2.
       DEC-19: localStorage is permitted on the scoring-tablet surface.
       --------------------------------------------------------------------- */
    var SWAP_OFFSET_KEY        = 'vvwt_swap_offset_field_' + FIELD_NUMBER;
    /* AC3, AC10 (E61S03): tiebreak 8-point threshold — deterministic mid-set switch. */
    var TIEBREAK_SWAP_THRESHOLD = 8;

    /* Load persisted manual-swap offset (0 or 1, default 0). */
    function loadSwapOffset() {
        try {
            var raw = window.localStorage ? window.localStorage.getItem(SWAP_OFFSET_KEY) : null;
            if (raw === '1') { return 1; }
        } catch (e) { /* ignore — iOS 9 private mode */ }
        return 0;
    }

    /* Save manual-swap offset to localStorage. */
    function saveSwapOffset(offset) {
        try {
            if (window.localStorage) {
                window.localStorage.setItem(SWAP_OFFSET_KEY, String(offset));
            }
        } catch (e) { /* ignore */ }
    }

    /*
     * AC2, AC3 (E61S03): Compute the deterministic swap component from the API state.
     * - Per-set alternation: setIndex % 2.
     * - Tiebreak 8-point switch: if isTiebreak AND max(t1Points, t2Points) >= TIEBREAK_SWAP_THRESHOLD,
     *   flip the alternation (XOR with 1).
     * This is a pure function — recomputed on every render and page reload (AC3, AC6).
     */
    function deterministicSwap(setIndex, isTiebreak, t1Points, t2Points) {
        var base = setIndex % 2;
        if (isTiebreak) {
            var maxPoints = t1Points > t2Points ? t1Points : t2Points;
            if (maxPoints >= TIEBREAK_SWAP_THRESHOLD) {
                base = 1 - base;
            }
        }
        return base;
    }

    /* AC4 (E61S03): Compute effective swap from deterministic component + manual offset. */
    function effectiveSwap(setIndex, isTiebreak, t1Points, t2Points) {
        var swapOffset = loadSwapOffset();
        return (deterministicSwap(setIndex, isTiebreak, t1Points, t2Points) + swapOffset) % 2;
    }

    /* -------------------------------------------------------------------------
       DOM references
       --------------------------------------------------------------------- */
    var elErrorBanner    = vvwtQuery('#error-banner');
    var elStatusMsg      = vvwtQuery('#status-msg');
    var elQueueStatus    = vvwtQuery('#queue-status');
    var elNoMatchPanel   = vvwtQuery('#no-match-panel');
    var elMatchPanel     = vvwtQuery('#match-panel');
    /* AC2: header identity spans */
    var elHeaderTeams    = vvwtQuery('#header-teams');
    var elHeaderRoundSet = vvwtQuery('#header-round-set');
    /* Referee row */
    var elRefereeRow     = vvwtQuery('#referee-row');
    var elRefereeName    = vvwtQuery('#referee-name');
    /* AC5: score column labels */
    var elLabelTeam1     = vvwtQuery('#label-team1');
    var elLabelTeam2     = vvwtQuery('#label-team2');
    /* AC5: single score inputs */
    var elInputTeam1     = vvwtQuery('#input-team1');
    var elInputTeam2     = vvwtQuery('#input-team2');
    /* AC9: +/- buttons */
    var elPlusTeam1      = vvwtQuery('#plus-team1');
    var elMinusTeam1     = vvwtQuery('#minus-team1');
    var elPlusTeam2      = vvwtQuery('#plus-team2');
    var elMinusTeam2     = vvwtQuery('#minus-team2');
    /* Confirm button and dialog */
    var elConfirmBtn     = vvwtQuery('#confirm-btn');
    var elConfirmDialog  = vvwtQuery('#confirm-dialog');
    var elConfirmScore   = vvwtQuery('#confirm-dialog-score');
    var elConfirmYesBtn  = vvwtQuery('#confirm-yes-btn');
    var elConfirmNoBtn   = vvwtQuery('#confirm-no-btn');
    /* AC1 (E61S03): swap control button */
    var elSwapBtn        = vvwtQuery('#swap-btn');

    /* -------------------------------------------------------------------------
       AC10: Token storage helpers (same pattern as register.mustache)
       --------------------------------------------------------------------- */

    function localStorageGet(key) {
        try { return window.localStorage ? window.localStorage.getItem(key) : null; }
        catch (e) { return null; }
    }

    function cookieGet(name) {
        var cookies = document.cookie ? document.cookie.split(';') : [];
        for (var i = 0; i < cookies.length; i++) {
            var parts = cookies[i].split('=');
            var n = (parts[0] || '').replace(/^\s+|\s+$/g, '');
            if (n === name) {
                return decodeURIComponent((parts[1] || '').replace(/^\s+|\s+$/g, ''));
            }
        }
        return null;
    }

    function retrieveToken() {
        var t = localStorageGet(TOKEN_STORAGE_KEY);
        if (t) { return t; }
        return cookieGet(TOKEN_COOKIE_NAME);
    }

    /* -------------------------------------------------------------------------
       AC5: Score display helpers — single input per team
       --------------------------------------------------------------------- */

    function updateScoreDisplay() {
        if (elInputTeam1) { elInputTeam1.value = String(score1); }
        if (elInputTeam2) { elInputTeam2.value = String(score2); }
    }

    /* -------------------------------------------------------------------------
       AC5: Partial score broadcast
       --------------------------------------------------------------------- */

    function sendPartialScore() {
        var token = retrieveToken();
        if (!token || !currentMatchId) { return; }

        vvwtFetch(
            '/api/score/partial',
            {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    matchId:     currentMatchId,
                    setIndex:    currentSetIndex,
                    team1Points: score1,
                    team2Points: score2,
                    deviceToken: token
                })
            },
            function () { /* success — no-op, partial is fire-and-forget */ },
            function (err) {
                if (window.console && window.console.warn) {
                    window.console.warn('[E61S01] Partial score error: ' + err);
                }
            }
        );
    }

    /* -------------------------------------------------------------------------
       AC9: +/- button and input handlers — operate on single score input
       --------------------------------------------------------------------- */

    function clamp(val) {
        if (val < 0)  { return 0; }
        if (val > 99) { return 99; }
        return val;
    }

    if (elPlusTeam1) {
        elPlusTeam1.onclick = function () {
            score1 = clamp(score1 + 1);
            updateScoreDisplay();
            sendPartialScore();
        };
    }
    if (elMinusTeam1) {
        elMinusTeam1.onclick = function () {
            score1 = clamp(score1 - 1);
            updateScoreDisplay();
            sendPartialScore();
        };
    }
    if (elPlusTeam2) {
        elPlusTeam2.onclick = function () {
            score2 = clamp(score2 + 1);
            updateScoreDisplay();
            sendPartialScore();
        };
    }
    if (elMinusTeam2) {
        elMinusTeam2.onclick = function () {
            score2 = clamp(score2 - 1);
            updateScoreDisplay();
            sendPartialScore();
        };
    }
    if (elInputTeam1) {
        elInputTeam1.onchange = function () {
            var v = parseInt(elInputTeam1.value, 10);
            score1 = isNaN(v) ? 0 : clamp(v);
            updateScoreDisplay();
            sendPartialScore();
        };
    }
    if (elInputTeam2) {
        elInputTeam2.onchange = function () {
            var v = parseInt(elInputTeam2.value, 10);
            score2 = isNaN(v) ? 0 : clamp(v);
            updateScoreDisplay();
            sendPartialScore();
        };
    }

    /* -------------------------------------------------------------------------
       AC1, AC4 (E61S03): Swap button handler — relative toggle.
       Increments the persisted swap offset (mod 2) and re-applies the visual swap
       to the currently shown match without reloading. Score bindings unchanged (AC5).
       --------------------------------------------------------------------- */

    if (elSwapBtn) {
        elSwapBtn.onclick = function () {
            var current = loadSwapOffset();
            saveSwapOffset(1 - current);
            applySwap(currentSetIndex, currentIsTiebreak, currentTeam1Points, currentTeam2Points);
        };
    }

    /*
     * AC2, AC3, AC4, AC5, AC6 (E61S03): Apply the visual swap to the displayed match.
     * Updates only the column labels and header team display — score input IDs are
     * structural (fixed) and their values remain bound to team1/team2 identity (AC5).
     * team1Name and team2Name are the authoritative names from the API (never swapped in storage).
     */
    function applySwap(setIndex, isTiebreak, t1Points, t2Points) {
        var swap = effectiveSwap(setIndex, isTiebreak, t1Points, t2Points);
        /* Retrieve team names stored on last renderMatch call */
        var leftName  = (swap === 1) ? currentTeam2Name : currentTeam1Name;
        var rightName = (swap === 1) ? currentTeam1Name : currentTeam2Name;

        /* AC2: update header — left vs right ordering */
        if (elHeaderTeams) {
            vvwtSetText(elHeaderTeams, leftName + ' ' + MSG_VS_LABEL + ' ' + rightName);
        }
        /* Update column labels (score inputs stay at their fixed IDs) */
        vvwtSetText(elLabelTeam1, leftName);
        vvwtSetText(elLabelTeam2, rightName);
    }

    /* Storage for team names used by applySwap between renderMatch calls */
    var currentTeam1Name = '';
    var currentTeam2Name = '';

    /* -------------------------------------------------------------------------
       AC5, AC7: Confirm dialog
       --------------------------------------------------------------------- */

    if (elConfirmBtn) {
        elConfirmBtn.onclick = function () {
            if (elConfirmScore) {
                vvwtSetText(elConfirmScore, score1 + ' : ' + score2);
            }
            vvwtShow(elConfirmDialog);
        };
    }

    if (elConfirmNoBtn) {
        elConfirmNoBtn.onclick = function () {
            vvwtHide(elConfirmDialog);
        };
    }

    if (elConfirmYesBtn) {
        elConfirmYesBtn.onclick = function () {
            vvwtHide(elConfirmDialog);
            submitSetResult(score1, score2);
        };
    }

    /* -------------------------------------------------------------------------
       AC7, AC11: Set result submission with offline queue
       --------------------------------------------------------------------- */

    function submitSetResult(t1, t2) {
        var token = retrieveToken();
        if (!token) {
            showError(MSG_ERROR_TOKEN);
            return;
        }
        if (!currentMatchId) {
            return;
        }

        showQueueStatus(MSG_QUEUE_PENDING);

        vvwtFetch(
            '/api/score/submit',
            {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    matchId:     currentMatchId,
                    setIndex:    currentSetIndex,
                    team1Points: t1,
                    team2Points: t2,
                    deviceToken: token
                })
            },
            function () {
                scoreQueue = [];
                showQueueStatus(MSG_QUEUE_SAVED);
                vvwtSetText(elStatusMsg, MSG_SUBMIT_SUCCESS);
                window.setTimeout(function () {
                    loadMatch();
                }, 1500);
            },
            function (err) {
                hideQueueStatus();
                if (err && err.indexOf('401') !== -1) {
                    showError(MSG_ERROR_TOKEN);
                } else if (err && err.indexOf('403') !== -1) {
                    showError(MSG_ERROR_FORBIDDEN);
                } else if (err && (err.indexOf('400') !== -1)) {
                    showError(MSG_ERROR_VALIDATION);
                } else {
                    scoreQueue.push({
                        matchId:     currentMatchId,
                        setIndex:    currentSetIndex,
                        team1Points: t1,
                        team2Points: t2
                    });
                    showError(MSG_ERROR_NET);
                }
            }
        );
    }

    function showQueueStatus(msg) {
        if (elQueueStatus) {
            vvwtSetText(elQueueStatus, msg);
            vvwtShow(elQueueStatus);
        }
    }

    function hideQueueStatus() {
        if (elQueueStatus) { vvwtHide(elQueueStatus); }
    }

    /* -------------------------------------------------------------------------
       Error display
       --------------------------------------------------------------------- */

    function showError(message) {
        if (elErrorBanner) {
            vvwtSetText(elErrorBanner, message);
            vvwtShow(elErrorBanner);
        }
        vvwtSetText(elStatusMsg, '');
    }

    function clearError() {
        if (elErrorBanner) { vvwtHide(elErrorBanner); }
    }

    /* -------------------------------------------------------------------------
       AC2: Populate header with match identity
       --------------------------------------------------------------------- */

    function clearHeader() {
        /* AC6: when no active match, header shows no team/round/set values */
        if (elHeaderTeams)    { vvwtSetText(elHeaderTeams, ''); }
        if (elHeaderRoundSet) { vvwtSetText(elHeaderRoundSet, ''); }
    }

    /* -------------------------------------------------------------------------
       AC1, AC4: Load and display the active match
       --------------------------------------------------------------------- */

    function loadMatch() {
        var token = retrieveToken();
        clearError();
        clearHeader();
        vvwtShow(elStatusMsg);
        vvwtSetText(elStatusMsg, MSG_LOADING);
        vvwtHide(elMatchPanel);
        vvwtHide(elNoMatchPanel);

        if (!token) {
            showError(MSG_ERROR_TOKEN);
            return;
        }

        vvwtFetch(
            '/api/score/match?field=' + FIELD_NUMBER + '&token=' + encodeURIComponent(token),
            { method: 'GET' },
            function (data) {
                vvwtSetText(elStatusMsg, '');
                if (!data) {
                    currentMatchId = null;
                    vvwtShow(elNoMatchPanel);
                    return;
                }
                renderMatch(data);
            },
            function (err) {
                if (err && err.indexOf('401') !== -1) {
                    showError(MSG_ERROR_TOKEN);
                } else if (err && err.indexOf('403') !== -1) {
                    showError(MSG_ERROR_FORBIDDEN);
                } else if (err && err.indexOf('204') !== -1) {
                    currentMatchId = null;
                    vvwtSetText(elStatusMsg, '');
                    vvwtShow(elNoMatchPanel);
                } else {
                    showError(MSG_ERROR_NET);
                }
            }
        );
    }

    function renderMatch(data) {
        currentMatchId      = data.matchId  || null;
        currentSetIndex     = data.setIndex || 0;
        currentIsTiebreak   = data.isTiebreak ? true : false;
        currentTeam1Points  = data.team1Points || 0;
        currentTeam2Points  = data.team2Points || 0;
        score1              = currentTeam1Points;
        score2              = currentTeam2Points;

        /* Store canonical team names (API order, never swapped) */
        currentTeam1Name = data.team1Name || '?';
        currentTeam2Name = data.team2Name || '?';

        /* AC2: round/set header (position-independent) */
        if (elHeaderRoundSet) {
            var lapNum = data.lapNumber || 0;
            var setNum = currentSetIndex + 1;
            vvwtSetText(elHeaderRoundSet,
                MSG_LAP_LABEL + ' ' + lapNum + ' — ' + MSG_SET_LABEL + ' ' + setNum);
        }

        /* Referee */
        if (data.refereeTeamName) {
            vvwtSetText(elRefereeName, data.refereeTeamName);
            vvwtShow(elRefereeRow);
        } else {
            vvwtHide(elRefereeRow);
        }

        /* AC5: update single score inputs */
        updateScoreDisplay();

        /*
         * AC2, AC3, AC4, AC6 (E61S03): Apply the visual team-position swap.
         * Deterministic component recomputed from current set, tiebreak status, and points.
         * Combined with persisted manual-swap offset loaded from localStorage.
         */
        applySwap(currentSetIndex, currentIsTiebreak, currentTeam1Points, currentTeam2Points);

        /* Retry any queued submissions (AC11) */
        if (scoreQueue.length > 0) {
            var queued = scoreQueue.shift();
            submitSetResult(queued.team1Points, queued.team2Points);
        }

        vvwtShow(elMatchPanel);
    }

    /* -------------------------------------------------------------------------
       Page init — load match on startup
       --------------------------------------------------------------------- */
    (function init() {
        loadMatch();
    }());

    </script>
</body>
</html>
