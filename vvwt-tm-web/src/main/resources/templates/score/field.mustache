<!DOCTYPE html>
<html lang="{{locale}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <!-- E44S02 AC3: VVW blue hex-icon favicon links — SVG first, PNG largest-to-smallest (AC7) -->
    <link rel="icon" type="image/svg+xml" href="/score/vvw-icon-blue.svg">
    <link rel="icon" type="image/png" sizes="256x256" href="/score/vvw-favicon-blue-256.png">
    <link rel="icon" type="image/png" sizes="128x128" href="/score/vvw-favicon-blue-128.png">
    <link rel="icon" type="image/png" sizes="64x64" href="/score/vvw-favicon-blue-64.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/score/vvw-favicon-blue-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/score/vvw-favicon-blue-16.png">
    <style>
        /*
         * E61S01 — Redesigned score entry page styles.
         * E65S06 — Layout refinements: bigger header team names; swap control at top;
         *          bigger footer text; parenthesised version; §13 link; bigger score inputs
         *          with spinner suppressed; symmetric three-zone header; aligned score boxes.
         * E65S07 — Battery hardening: relaxed poll interval (30 s), Page Visibility API guard
         *          (no polling when hidden), idle-timeout (30 min) with tap-to-refresh control.
         * iOS 9 Safari compatible: no flexbox/grid quirks, no CSS container queries.
         * DEC-19: scoring tablet surface; Mustache + ES5 only.
         */
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            font-size: 18px;
            background: #1a1a2e;
            color: #eee;
            text-align: center;
        }
        /* AC2 (E61S01): field-page header — match identity (teams + round/set)
         * AC7 (E65S06): three-zone symmetric layout — team1 | vs | team2 */
        #field-header {
            background: #16163a;
            border-bottom: 1px solid #333;
            padding: 10px 16px;
            min-height: 48px;
        }
        /*
         * AC7 (E65S06): Three-zone header bar using display:table layout.
         * iOS 9 Safari supports display:table/table-cell reliably (flexbox has quirks
         * with flex-grow on WebKit 600; table layout is fully reliable).
         */
        #header-teams {
            display: table;
            width: 100%;
            table-layout: fixed;
        }
        /* AC1 (E65S06): team name zones — larger font than before (was 1.1em) */
        #header-team1,
        #header-team2 {
            display: table-cell;
            width: 42%;
            font-size: 1.3em;
            font-weight: bold;
            color: #f0f0f0;
            vertical-align: middle;
            word-wrap: break-word;
            overflow-wrap: break-word;
        }
        #header-team1 {
            text-align: left;
        }
        #header-team2 {
            text-align: right;
        }
        /* AC7 (E65S06): centred "vs." cell — stays horizontally centred regardless
         * of team-name lengths because all three cells are table-cells of fixed width */
        #header-vs {
            display: table-cell;
            width: 16%;
            font-size: 0.9em;
            font-weight: normal;
            color: #888;
            text-align: center;
            vertical-align: middle;
            white-space: nowrap;
        }
        #header-round-set {
            display: block;
            font-size: 0.8em;
            color: #888;
            margin-top: 4px;
        }
        #page-wrapper {
            padding: 16px 16px 140px;
            max-width: 80vw;
            margin: 0 auto;
        }
        /* AC8 (E61S01): global error banner.
         * E49S03 M-C: initial hide via inline style="display:none" on the element. */
        #error-banner {
            background: #c0392b;
            color: #fff;
            padding: 12px 16px;
            margin-bottom: 16px;
            border-radius: 4px;
            font-size: 0.9em;
        }
        /* Status / loading message */
        #status-msg {
            font-size: 0.95em;
            color: #777;
            margin-bottom: 20px;
            min-height: 1.4em;
        }
        /* AC9 (E61S01): no-match panel.
         * E49S03 M-C: initial hide via inline style="display:none". */
        #no-match-panel {
            padding: 32px 16px;
            color: #666;
            font-size: 1em;
        }
        /*
         * AC3 (E65S07): tap-to-refresh panel — hidden initially; shown when idle-timeout fires.
         * The tap-to-refresh button has prominent styling so the operator can easily see and
         * tap it to resume polling after an extended phase pause.
         */
        #tap-to-refresh-panel {
            padding: 24px 16px;
            text-align: center;
        }
        #tap-to-refresh-btn {
            display: inline-block;
            padding: 14px 28px;
            font-size: 1em;
            background: #2c2c5a;
            color: #ccc;
            border: 1px solid #555;
            border-radius: 6px;
            cursor: pointer;
        }
        /* AC2 (E65S06): swap control — horizontally centred, text-width only, above score area */
        #swap-btn {
            display: inline-block;
            padding: 10px 20px;
            font-size: 0.95em;
            background: #444466;
            color: #ccc;
            border: 1px solid #555;
            border-radius: 6px;
            cursor: pointer;
            margin: 0 auto 16px;
        }
        /* match display panel */
        #match-panel {
        }
        /* AC5 (E61S01): score entry area — single field per team */
        #score-area {
            margin-bottom: 28px;
        }
        /*
         * AC8 (E65S06): Score columns — display:table/table-cell to align both score
         * boxes at the same vertical height even when one team-name label wraps onto
         * more lines than the other.
         * table-layout:fixed + equal widths guarantee both cells always sit at the
         * same baseline regardless of label line count.
         */
        #score-columns {
            display: table;
            width: 100%;
            table-layout: fixed;
        }
        .score-col {
            display: table-cell;
            width: 50%;
            vertical-align: top;
            padding: 0 4px;
        }
        .score-col-label {
            font-size: 0.85em;
            color: #888;
            margin-bottom: 8px;
            min-height: 2.4em;
            word-wrap: break-word;
            overflow-wrap: break-word;
        }
        /*
         * AC6 (E65S06): Larger score input; native number-spinner suppressed.
         * -webkit-appearance: none / -moz-appearance: textfield suppress the
         * native +/- spinner controls on Chrome (webkit) and Firefox (moz).
         * The custom +/- buttons replace the spinner (operator may veto per Brief D-7).
         */
        .score-input {
            display: block;
            width: 90%;
            margin: 0 auto 10px;
            font-size: 8em;
            font-weight: bold;
            text-align: center;
            padding: 14px 4px;
            background: #2d2d54;
            color: #fff;
            border: 2px solid #444;
            border-radius: 8px;
            -webkit-appearance: none;
            -moz-appearance: textfield;
            appearance: none;
        }
        /* Remove inner spinner arrows (Webkit) */
        .score-input::-webkit-inner-spin-button,
        .score-input::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        /* AC6 (E65S06): +/- buttons — sized to stay flush with score input edges */
        .btn-plus, .btn-minus {
            display: inline-block;
            width: 44%;
            padding: 12px 0;
            font-size: 3em;
            font-weight: bold;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            margin: 2px 1%;
        }
        .btn-plus  { background: #27ae60; color: #fff; }
        .btn-minus { background: #7f8c8d; color: #fff; }
        /* AC5 (E61S01): confirm button */
        #confirm-btn {
            display: block;
            width: 90%;
            margin: 4em auto 20px;
            padding: 14px 0;
            font-size: 1.1em;
            background: #2980b9;
            color: #fff;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }
        /* queue status pill */
        #queue-status {
            font-size: 0.75em;
            color: #888;
            margin-bottom: 12px;
        }
        /* AC5 (E61S01): confirmation dialog overlay */
        #confirm-dialog {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.7);
            z-index: 100;
        }
        #confirm-dialog-box {
            background: #22224a;
            border-radius: 10px;
            padding: 32px 24px 24px;
            margin: 18% auto 0;
            max-width: 380px;
            width: 90%;
        }
        #confirm-dialog-heading {
            font-size: 1.1em;
            color: #eee;
            margin-bottom: 10px;
        }
        #confirm-dialog-prompt {
            font-size: 0.95em;
            color: #aaa;
            margin-bottom: 24px;
        }
        #confirm-dialog-score {
            font-size: 2em;
            font-weight: bold;
            color: #fff;
            margin-bottom: 24px;
        }
        .confirm-dialog-btn {
            display: inline-block;
            width: 44%;
            margin: 0 2%;
            padding: 12px 0;
            font-size: 1em;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }
        #confirm-yes-btn { background: #27ae60; color: #fff; }
        #confirm-no-btn  { background: #555; color: #eee; }
        /* AC3 (E61S01), AC4 (E61S01): bottom bar — fixed at page bottom */
        #bottom-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 8px 16px;
            background: #0e0e22;
            border-top: 1px solid #222;
        }
        /* AC3 (E65S06): bottom-left "Scoring Tablet" wordmark — larger than before (was 0.7em) */
        #bottom-wordmark {
            position: absolute;
            left: 16px;
            bottom: 8px;
            font-size: 0.85em;
            color: #555;
            white-space: nowrap;
        }
        #bottom-wordmark img.icon-o {
            width: 12px;
            height: 12px;
            vertical-align: middle;
        }
        /* AC4 (E65S06): bottom-centre field number — larger than before (was 0.75em → 0.9em) */
        #bottom-field-number {
            display: inline-block;
            font-size: 0.9em;
            color: #555;
        }
        /* AC4 (E65S06): version stays at its current small size — NOT enlarged per story note */
        #version-info {
            font-size: 0.6em;
            color: #3a3a5a;
            margin-left: 1em;
        }
        /*
         * AC5 (E65S06): §13 AGPL source-code link — bottom-right of footer.
         * Same plain-link pattern as E59S03 on register.mustache / hello.mustache.
         */
        #bottom-source-link {
            position: absolute;
            right: 16px;
            bottom: 12px;
            font-size: 0.6em;
            color: #3a3a5a;
            white-space: nowrap;
        }
        #bottom-source-link a {
            color: #3a3a5a;
        }
    </style>
</head>
<body>
    <!-- AC2 (E61S01): field-page header — match identity (teams + round/set), populated by JS
         AC7 (E65S06): Three-zone symmetric layout — team1 | vs | team2
         The three inner spans are each populated individually by applySwap() in the inline script. -->
    <div id="field-header">
        <div id="header-teams">
            <span id="header-team1"></span>
            <span id="header-vs"></span>
            <span id="header-team2"></span>
        </div>
        <span id="header-round-set"></span>
    </div>

    <!--
        AC2 (E65S06): Swap control at the top of the page — directly below the header bar,
        horizontally centred, only as wide as its label text. Placed OUTSIDE #match-panel
        so it is always visible (above the score area) whenever the page is loaded.
    -->
    <div style="text-align: center; padding-top: 12px;">
        <button id="swap-btn" type="button">{{msgSwapLabel}}</button>
    </div>

    <div id="page-wrapper">

        <!-- AC8 (E61S01): global error banner.
             E49S03 M-C: inline style="display:none" for vvwtShow compatibility. -->
        <div id="error-banner" style="display:none"></div>

        <!-- Status / loading line -->
        <div id="status-msg">{{msgLoading}}</div>

        <!-- queue status.
             E49S03 M-C: inline style="display:none" for vvwtShow compatibility. -->
        <div id="queue-status" style="display:none"></div>

        <!-- AC9 (E61S01): no-match panel — shown when no active match on this field.
             E49S03 M-C: inline style="display:none" for vvwtShow compatibility. -->
        <div id="no-match-panel" style="display:none">{{msgNoMatch}}</div>

        <!--
            AC3 (E65S07): tap-to-refresh panel — hidden initially; shown when idle-timeout fires
            (IDLE_TIMEOUT_MS elapsed in no-match/waiting state). The operator taps this button
            to resume polling after an extended phase pause. Initially hidden (display:none).
            E49S03 M-C pattern: inline style="display:none" for vvwtShow compatibility.
        -->
        <div id="tap-to-refresh-panel" style="display:none">
            <button id="tap-to-refresh-btn" type="button">{{msgTapToRefresh}}</button>
        </div>

        <!-- AC5 (E61S01): match display + score entry panel.
             E49S03 M-C: inline style="display:none" for vvwtShow compatibility. -->
        <div id="match-panel" style="display:none">

            <!-- Referee row (shown only if referee present) -->
            <div id="referee-row" style="display:none">
                {{msgRefereeLabel}}: <span id="referee-name"></span>
            </div>

            <!-- AC5 (E61S01): score entry area — single editable field per team
                 AC8 (E65S06): #score-columns uses table layout to keep both score boxes at the
                 same vertical height regardless of team-name label line count. -->
            <div id="score-area">
                <div id="score-columns">
                    <!-- Team 1 column -->
                    <div class="score-col" id="col-team1">
                        <!-- AC5: single large editable input (replaces score-display + small input)
                             AC6 (E65S06): native spinner suppressed via CSS (see .score-input) -->
                        <input class="score-input" id="input-team1" type="number" min="0" max="99"
                               value="0">
                        <!-- +/- buttons operate on input-team1 -->
                        <button class="btn-plus"  id="plus-team1"  type="button">{{msgPlusLabel}}</button>
                        <button class="btn-minus" id="minus-team1" type="button">{{msgMinusLabel}}</button>
                        <div class="score-col-label" id="label-team1"></div>
                    </div>

                    <!-- Team 2 column -->
                    <div class="score-col" id="col-team2">
                        <!-- AC5: single large editable input (replaces score-display + small input)
                             AC6 (E65S06): native spinner suppressed via CSS (see .score-input) -->
                        <input class="score-input" id="input-team2" type="number" min="0" max="99"
                               value="0">
                        <!-- +/- buttons operate on input-team2 -->
                        <button class="btn-plus"  id="plus-team2"  type="button">{{msgPlusLabel}}</button>
                        <button class="btn-minus" id="minus-team2" type="button">{{msgMinusLabel}}</button>
                        <div class="score-col-label" id="label-team2"></div>
                    </div>
                </div>
            </div><!-- /#score-area -->

            <!-- AC5 (E61S01): confirm set result button -->
            <button id="confirm-btn" type="button">{{msgConfirmHeading}}</button>

        </div><!-- /#match-panel -->

    </div><!-- /#page-wrapper -->

    <!-- AC5 (E61S01): confirmation dialog overlay.
         E49S03 M-C: inline style="display:none" for vvwtShow compatibility. -->
    <div id="confirm-dialog" style="display:none">
        <div id="confirm-dialog-box">
            <div id="confirm-dialog-heading">{{msgConfirmHeading}}</div>
            <div id="confirm-dialog-prompt">{{msgConfirmPrompt}}</div>
            <div id="confirm-dialog-score"></div>
            <button class="confirm-dialog-btn" id="confirm-yes-btn" type="button">{{msgConfirmYes}}</button>
            <button class="confirm-dialog-btn" id="confirm-no-btn"  type="button">{{msgConfirmNo}}</button>
        </div>
    </div>

    <!-- AC3 (E61S01), AC4 (E61S01): bottom bar — fixed at page bottom -->
    <div id="bottom-bar">
        <!-- AC3 (E65S06): bottom-left "Scoring Tablet" wordmark — letter 'o' as vvw-icon-blue.svg
             Font size increased from 0.7em to 0.85em per AC3 (L3 — larger footer text). -->
        <div id="bottom-wordmark">Sc<img src="/score/vvw-icon-blue.svg" alt="o" class="icon-o">ring Tablet
            <!-- AC4 (E65S06): version in parentheses, at original small size (not enlarged) -->
            <span id="version-info">({{versionLabel}}: {{appVersion}})</span>
        </div>
        <!-- AC4 (E65S06): bottom-centre field number — somewhat larger (was 0.75em → 0.9em per L3).
             Version shown in parentheses per AC4 (L4). The version text is NOT enlarged. -->
        <div id="bottom-field-number">{{msgFieldLabel}} {{fieldNumber}}</div>
        <!--
            AC5 (E65S06): AGPL §13 source-code offer — plain static link at bottom-right.
            Same link text and target as E59S03 on register.mustache / hello.mustache (DEC-75).
            No new JavaScript introduced (DEC-19).
        -->
        <div id="bottom-source-link">
            Source code (AGPL-3.0-or-later):
            <a href="https://github.com/vvwt/vvwt-prj">https://github.com/vvwt/vvwt-prj</a>
        </div>
    </div>

    <!--
        E06S02 AC4 (ES5 utility script) + DEC-19:
        Only the shared ES5 utility script and inline ES5 are permitted on this page.
        No npm-bundled code, no Svelte, no modern JS framework.
    -->
    <script src="/score/assets/vvwt-tablet.js"></script>

    <!--
        E61S01 inline ES5 score-entry logic — redesigned.
        E61S03 — Team-position swap added (AC1–AC10).
        E65S05 — Auto-advance polling added (AC1–AC8):
                 When no active match found, poll every POLL_INTERVAL_MS ms until a match
                 appears (tournament advances to next round). Uses window.setInterval /
                 window.clearInterval (ES5 — iOS 9 safe). stopPolling() is called as soon
                 as renderMatch() is entered so the tablet never continues polling while a
                 match is displayed. AC5: polling also continues on network errors so once
                 connectivity returns the next interval fires and loads the correct match.
        E65S07 — Battery hardening (AC1–AC8):
                 AC1: POLL_INTERVAL_MS relaxed from 5000 ms to 30000 ms (30 s). Auto-advance
                      latency bound ≤60 s still met (at most one 30 s interval before advancing).
                 AC2: Page Visibility API guard — isPageHidden() checks document.hidden /
                      document.webkitHidden (vendor-prefix for iOS 9 Safari). visibilitychange
                      (+webkitvisibilitychange fallback) event: hidden → stopPolling +
                      stopIdleTimeout; visible → resume polling + idle timer if not in idle state.
                 AC3: Idle-timeout — IDLE_TIMEOUT_MS = 1800000 ms (30 min). After this long in
                      the no-match/waiting state, stopPolling() fires, tap-to-refresh panel shown.
                      Tapping calls loadMatch() directly; if a match is now available it is shown;
                      otherwise waiting state re-entered (polling + idle timer restart).
                 AC4: idleTimeoutFired flag guards startPolling() — auto-advance via polling remains
                      primary path; AC3 manual tap is the recovery surface AFTER idle fires.
                 AC5: Network errors do not set idleTimeoutFired — polling continues (same as E65S05).
                 AC6: ES5 only. Feature detection for Page Visibility API with vendor-prefix fallback.
        E65S06 — Layout refinements (AC1–AC12):
                 AC1: header team names larger (CSS only).
                 AC2: swap control moved to top of page (HTML structure change; #swap-btn
                      is now OUTSIDE #match-panel, always visible above the score area).
                 AC3: footer text larger (CSS only).
                 AC4: version in parentheses (template change only).
                 AC5: §13 source-code link added to footer (template change only).
                 AC6: score inputs larger + native spinner suppressed (CSS only).
                 AC7: header restructured to three-zone layout — #header-team1 / #header-vs /
                      #header-team2; applySwap() updated to set each element individually.
                 AC8: score-box alignment via table layout (CSS only; #score-columns wrapper).
                 AC9: long-name robustness via word-wrap + min-height CSS (no JS change).
        DEC-19 constraint: ECMAScript 5 only.
        Relies on helpers from /score/assets/vvwt-tablet.js (must load first):
          vvwtFetch, vvwtSetText, vvwtShow, vvwtHide, vvwtQuery
        E61S03 swap model: effectiveSwap = (deterministicSwap(setIndex, isTiebreak, pts) + swapOffset) % 2.
        deterministicSwap = setIndex%2 XOR tiebreak-8-point-switch. swapOffset from localStorage.
        E65S03 currentSwap: applySwap() sets currentSwap=swap; updateScoreDisplay() and +/- handlers
        route to score1 or score2 based on currentSwap. AC4: score1/score2 payload mapping is team-fixed.
        E65S06 applySwap: sets elHeaderTeam1, elHeaderVs, elHeaderTeam2 individually (three-zone header).
        DEC-19: ECMAScript 5 only — var, named functions, no arrow/class/template literals.
    -->
    <script>
    /* =========================================================================
       E61S01 — Score-entry page ES5 inline script (redesigned).
       E61S03 — Team-position swap added (AC1–AC10).
       E65S05 — Auto-advance polling added (AC1–AC8).
       E65S06 — Layout refinements: applySwap() updated for three-zone header (AC7).
       E65S07 — Battery hardening: relaxed poll interval (30 s), Page Visibility API guard,
                idle-timeout (30 min) with tap-to-refresh manual resume control.
       DEC-19 constraint: ECMAScript 5 only.
       Relies on helpers from /score/assets/vvwt-tablet.js (must load first):
         vvwtFetch, vvwtSetText, vvwtShow, vvwtHide, vvwtQuery
       ========================================================================= */

    /* -------------------------------------------------------------------------
       i18n strings (AC7) — injected by Mustache controller
       --------------------------------------------------------------------- */
    var MSG_LOADING          = '{{msgLoading}}';
    var MSG_NO_MATCH         = '{{msgNoMatch}}';
    var MSG_ERROR_NET        = '{{msgErrorNet}}';
    var MSG_ERROR_TOKEN      = '{{msgErrorToken}}';
    var MSG_ERROR_FORBIDDEN  = '{{msgErrorForbidden}}';
    var MSG_ERROR_VALIDATION = '{{msgErrorValidation}}';
    var MSG_SUBMIT_SUCCESS   = '{{msgSubmitSuccess}}';
    var MSG_QUEUE_PENDING    = '{{msgQueuePending}}';
    var MSG_QUEUE_SAVED      = '{{msgQueueSaved}}';
    var MSG_LAP_LABEL        = '{{msgLapLabel}}';
    var MSG_SET_LABEL        = '{{msgSetLabel}}';
    var MSG_VS_LABEL         = '{{msgVsLabel}}';
    var MSG_SWAP_LABEL       = '{{msgSwapLabel}}';

    /* -------------------------------------------------------------------------
       Page state
       --------------------------------------------------------------------- */
    var FIELD_NUMBER         = {{fieldNumber}};
    var TOKEN_STORAGE_KEY    = 'vvwt_device_token';
    var TOKEN_COOKIE_NAME    = 'vvwt_device_token';

    /* Current match state */
    var currentMatchId       = null;
    var currentSetIndex      = 0;
    var currentIsTiebreak    = false;
    var currentTeam1Points   = 0;
    var currentTeam2Points   = 0;
    var score1               = 0;
    var score2               = 0;

    /*
     * AC2, AC3 (E65S03): currentSwap — active swap state (0 = normal, 1 = swapped).
     * Updated by applySwap() on every render and swap-button press.
     * Consulted by updateScoreDisplay() and all +/- handlers so each on-screen column
     * consistently shows and modifies the score of the team displayed in that column.
     * AC4 invariant: score1/score2 always hold team1/team2 points respectively;
     * the team1Points/team2Points payload in sendPartialScore() and submitSetResult()
     * is always team-fixed (never changed by a swap).
     */
    var currentSwap          = 0;

    /* offline score queue — array of {matchId, setIndex, team1Points, team2Points} */
    var scoreQueue           = [];

    /*
     * AC1, AC2, AC3 (E65S07): Battery-aware polling state.
     *
     * POLL_INTERVAL_MS — relaxed from 5000 ms (E65S05) to 30000 ms (30 s).
     *   AC1: auto-advance latency bound ≤60 s is still met (at most one 30 s interval).
     *   This alone reduces the poll frequency 6× vs E65S05.
     *
     * IDLE_TIMEOUT_MS — after this long in the no-match/waiting state without a match appearing,
     *   polling stops and the tap-to-refresh panel is shown (AC3). 1800000 ms = 30 min.
     *   Long enough that normal between-round waits (typically < 15 min) never trigger it.
     *   Designed for phase pauses of an hour or more.
     *
     * pollIntervalId  — handle returned by window.setInterval; null when polling is not active.
     * idleTimeoutId   — handle returned by window.setTimeout for the idle timeout; null when not armed.
     * idleTimeoutFired — true once the idle timeout fires; guards startPolling() so polling does
     *   not restart automatically while the tablet is in the manual-resume state (AC4).
     *
     * DEC-19: window.setInterval, window.clearInterval, window.setTimeout, window.clearTimeout
