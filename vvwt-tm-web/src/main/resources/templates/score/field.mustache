        document.addEventListener('webkitvisibilitychange', onVisibilityChange, false);
    }

    /*
     * AC2, AC3, AC4, AC5, AC6 (E61S03): Apply the visual swap to the displayed match.
     * AC2, AC3 (E65S03): Extended — updates displayed score values so each column shows
     * the score of the team displayed in that column; records swap state in currentSwap.
     * AC7 (E65S06): Updated for three-zone header — sets #header-team1, #header-vs, and
     * #header-team2 individually. The "vs." separator is set from MSG_VS_LABEL (always
     * centred by CSS table-cell layout). Left/right team name routing depends on swap state.
     * AC4 invariant: score1/score2 remain team-fixed; the swap is presentation-only.
     */
    function applySwap(setIndex, isTiebreak, t1Points, t2Points) {
        var swap = effectiveSwap(setIndex, isTiebreak, t1Points, t2Points);
        /* Record active swap state so updateScoreDisplay() and handlers route correctly */
        currentSwap = swap;

        /* Retrieve team names stored on last renderMatch call */
        var leftName  = (swap === 1) ? currentTeam2Name : currentTeam1Name;
        var rightName = (swap === 1) ? currentTeam1Name : currentTeam2Name;

        /*
         * AC7 (E65S06): Update three-zone symmetric header.
         * Each zone is a separate element; the "vs." centre zone stays centred
         * regardless of left/right name lengths (CSS display:table fixed layout).
         */
        if (elHeaderTeam1) { vvwtSetText(elHeaderTeam1, leftName); }
        if (elHeaderVs)    { vvwtSetText(elHeaderVs,    MSG_VS_LABEL); }
        if (elHeaderTeam2) { vvwtSetText(elHeaderTeam2, rightName); }

        /* Update score-area column labels */
        vvwtSetText(elLabelTeam1, leftName);
        vvwtSetText(elLabelTeam2, rightName);

