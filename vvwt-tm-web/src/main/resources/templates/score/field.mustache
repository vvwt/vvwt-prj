    /* Storage for team names used by applySwap between renderMatch calls */
    var currentTeam1Name = '';
    var currentTeam2Name = '';

    /* -------------------------------------------------------------------------
       Confirm dialog
       --------------------------------------------------------------------- */

    if (elConfirmBtn) {
        elConfirmBtn.onclick = function () {
            if (elConfirmScore) {
                vvwtSetText(elConfirmScore, score1 + ' : ' + score2);
            }
            vvwtShow(elConfirmDialog);
        };
    }

    if (elConfirmNoBtn) {
        elConfirmNoBtn.onclick = function () {
            vvwtHide(elConfirmDialog);
        };
    }

    if (elConfirmYesBtn) {
        elConfirmYesBtn.onclick = function () {
            vvwtHide(elConfirmDialog);
            submitSetResult(score1, score2);
        };
    }

    /* -------------------------------------------------------------------------
       Set result submission with offline queue
       --------------------------------------------------------------------- */

    function submitSetResult(t1, t2) {
        var token = retrieveToken();
        if (!token) {
            showError(MSG_ERROR_TOKEN);
            return;
        }
        if (!currentMatchId) {
            return;
        }

        showQueueStatus(MSG_QUEUE_PENDING);

        vvwtFetch(
            '/api/score/submit',
            {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    matchId:     currentMatchId,
                    setIndex:    currentSetIndex,
                    team1Points: t1,
                    team2Points: t2,
                    deviceToken: token
                })
            },
            function () {
                scoreQueue = [];
                showQueueStatus(MSG_QUEUE_SAVED);
                vvwtSetText(elStatusMsg, MSG_SUBMIT_SUCCESS);
                window.setTimeout(function () {
                    loadMatch();
                }, 1500);
            },
            function (err) {
                hideQueueStatus();
                if (err && err.indexOf('401') !== -1) {
                    showError(MSG_ERROR_TOKEN);
                } else if (err && err.indexOf('403') !== -1) {
                    showError(MSG_ERROR_FORBIDDEN);
                } else if (err && (err.indexOf('400') !== -1)) {
                    showError(MSG_ERROR_VALIDATION);
                } else {
                    scoreQueue.push({
                        matchId:     currentMatchId,
                        setIndex:    currentSetIndex,
                        team1Points: t1,
                        team2Points: t2
                    });
                    showError(MSG_ERROR_NET);
                }
            }
        );
    }

    function showQueueStatus(msg) {
        if (elQueueStatus) {
            vvwtSetText(elQueueStatus, msg);
            vvwtShow(elQueueStatus);
        }
    }

    function hideQueueStatus() {
        if (elQueueStatus) { vvwtHide(elQueueStatus); }
    }

    /* -------------------------------------------------------------------------
       Error display
       --------------------------------------------------------------------- */

    function showError(message) {
        if (elErrorBanner) {
            vvwtSetText(elErrorBanner, message);
            vvwtShow(elErrorBanner);
        }
        vvwtSetText(elStatusMsg, '');
    }

    function clearError() {
        if (elErrorBanner) { vvwtHide(elErrorBanner); }
    }

    /* -------------------------------------------------------------------------
       Populate header with match identity
       --------------------------------------------------------------------- */

    function clearHeader() {
        /* AC6 (E61S01): when no active match, header shows no team/round/set values */
        if (elHeaderTeam1)    { vvwtSetText(elHeaderTeam1, ''); }
        if (elHeaderVs)       { vvwtSetText(elHeaderVs, ''); }
        if (elHeaderTeam2)    { vvwtSetText(elHeaderTeam2, ''); }
        if (elHeaderRoundSet) { vvwtSetText(elHeaderRoundSet, ''); }
    }

    /* -------------------------------------------------------------------------
       Load and display the active match
       --------------------------------------------------------------------- */

    function loadMatch() {
        var token = retrieveToken();
        clearError();
        clearHeader();
        vvwtShow(elStatusMsg);
        vvwtSetText(elStatusMsg, MSG_LOADING);
        vvwtHide(elMatchPanel);
        vvwtHide(elNoMatchPanel);

        if (!token) {
            showError(MSG_ERROR_TOKEN);
            return;
        }

        vvwtFetch(
            '/api/score/match?field=' + FIELD_NUMBER + '&token=' + encodeURIComponent(token),
            { method: 'GET' },
            function (data) {
                vvwtSetText(elStatusMsg, '');
                if (!data) {
                    /*
                     * AC3 (E65S05): No active match on this field — enter waiting/idle state
                     * and start polling so the tablet advances automatically when the phase
                     * advances to the next round.
                     * AC4 (E65S07): startPolling() guards on idleTimeoutFired — if idle timeout
                     * has already fired, polling will not restart; operator must tap to resume.
                     */
                    currentMatchId = null;
                    if (!idleTimeoutFired) {
                        vvwtShow(elNoMatchPanel);
                        startPolling();
                        startIdleTimeout();
                    }
                    /* If idleTimeoutFired, tap-to-refresh panel is already shown — no change. */
                    return;
                }
                renderMatch(data);
            },
            function (err) {
                if (err && err.indexOf('401') !== -1) {
                    showError(MSG_ERROR_TOKEN);
                } else if (err && err.indexOf('403') !== -1) {
                    showError(MSG_ERROR_FORBIDDEN);
                } else if (err && err.indexOf('204') !== -1) {
                    /*
                     * AC3 (E65S05): 204 No Content = no match for this field — waiting state.
                     * AC4 (E65S07): guard on idleTimeoutFired before starting polling.
                     */
                    currentMatchId = null;
                    vvwtSetText(elStatusMsg, '');
                    if (!idleTimeoutFired) {
                        vvwtShow(elNoMatchPanel);
                        startPolling();
                        startIdleTimeout();
                    }
                } else {
                    /*
                     * AC5 (E65S05/E65S07): Network error — start polling so once connectivity
                     * returns the round-tracking mechanism fires and shows the correct match.
                     * Error banner remains visible; poll fires silently in the background.
                     * AC5 (E65S07): Network errors do not set idleTimeoutFired — the idle timer
                     * continues running independently. Polling resumes once connectivity returns.
                     */
                    showError(MSG_ERROR_NET);
                    if (!idleTimeoutFired) {
                        startPolling();
                    }
                }
            }
        );
    }

    function renderMatch(data) {
        /*
         * AC2 (E65S05): A match was found — stop polling.
         * AC3 (E65S07): Also stop idle timeout and reset idleTimeoutFired so a subsequent
         * no-match entry will start a fresh idle-timeout cycle.
         * Hide tap-to-refresh panel in case it was showing (AC3 E65S07).
         */
        stopPolling();
        stopIdleTimeout();
        idleTimeoutFired = false;
        if (elTapToRefreshPanel) { vvwtHide(elTapToRefreshPanel); }

        currentMatchId      = data.matchId  || null;
        currentSetIndex     = data.setIndex || 0;
        currentIsTiebreak   = data.isTiebreak ? true : false;
        currentTeam1Points  = data.team1Points || 0;
        currentTeam2Points  = data.team2Points || 0;
        score1              = currentTeam1Points;
        score2              = currentTeam2Points;

        /* Store canonical team names (API order, never swapped) */
        currentTeam1Name = data.team1Name || '?';
        currentTeam2Name = data.team2Name || '?';

        /* AC2: round/set header (position-independent) */
        if (elHeaderRoundSet) {
            var lapNum = data.lapNumber || 0;
            var setNum = currentSetIndex + 1;
            vvwtSetText(elHeaderRoundSet,
                MSG_LAP_LABEL + ' ' + lapNum + ' — ' + MSG_SET_LABEL + ' ' + setNum);
        }

        /* Referee */
        if (data.refereeTeamName) {
            vvwtSetText(elRefereeName, data.refereeTeamName);
            vvwtShow(elRefereeRow);
        } else {
            vvwtHide(elRefereeRow);
        }

        /* update single score inputs */
        updateScoreDisplay();

        /*
         * AC2, AC3, AC4, AC6 (E61S03): Apply the visual team-position swap.
         * AC7 (E65S06): applySwap() now updates three separate header elements.
         * Deterministic component recomputed from current set, tiebreak status, and points.
         * Combined with persisted manual-swap offset loaded from localStorage.
         */
        applySwap(currentSetIndex, currentIsTiebreak, currentTeam1Points, currentTeam2Points);

        /* Retry any queued submissions */
        if (scoreQueue.length > 0) {
            var queued = scoreQueue.shift();
            submitSetResult(queued.team1Points, queued.team2Points);
        }

        vvwtShow(elMatchPanel);
    }

    /* -------------------------------------------------------------------------
       Page init — load match on startup
       --------------------------------------------------------------------- */
    (function init() {
        loadMatch();
    }());

    </script>
</body>
</html>
