    function onVisibilityChange() {
        if (isPageHidden()) {
            /*
             * Page is hidden: stop polling and idle timer to save battery.
             * When the page becomes visible again we will decide whether to resume
             * based on the idleTimeoutFired state.
             */
            stopPolling();
            stopIdleTimeout();
        } else {
            /*
             * Page has become visible.
             * If a match is currently displayed (currentMatchId non-null), polling is not
             * active anyway — nothing to resume.
             * If we are in the manual-resume state (idleTimeoutFired), show tap-to-refresh
             * panel and wait for operator tap — do NOT auto-restart polling.
             * Otherwise resume polling and re-arm idle timer.
             */
            if (currentMatchId === null && !idleTimeoutFired) {
                startPolling();
                startIdleTimeout();
            } else if (currentMatchId === null && idleTimeoutFired) {
                /* Make sure tap-to-refresh panel is visible */
                vvwtHide(elNoMatchPanel);
                if (elTapToRefreshPanel) { vvwtShow(elTapToRefreshPanel); }
            }
