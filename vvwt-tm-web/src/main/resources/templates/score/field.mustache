        if (val > 99) { return 99; }
        return val;
    }

    if (elPlusTeam1) {
        elPlusTeam1.onclick = function () {
            if (currentSwap === 1) { score2 = clamp(score2 + 1); }
            else                   { score1 = clamp(score1 + 1); }
            updateScoreDisplay();
            sendPartialScore();
        };
    }
    if (elMinusTeam1) {
        elMinusTeam1.onclick = function () {
            if (currentSwap === 1) { score2 = clamp(score2 - 1); }
            else                   { score1 = clamp(score1 - 1); }
            updateScoreDisplay();
            sendPartialScore();
        };
    }
    if (elPlusTeam2) {
        elPlusTeam2.onclick = function () {
            if (currentSwap === 1) { score1 = clamp(score1 + 1); }
            else                   { score2 = clamp(score2 + 1); }
            updateScoreDisplay();
            sendPartialScore();
        };
    }
    if (elMinusTeam2) {
        elMinusTeam2.onclick = function () {
            if (currentSwap === 1) { score1 = clamp(score1 - 1); }
            else                   { score2 = clamp(score2 - 1); }
            updateScoreDisplay();
            sendPartialScore();
        };
    }
    if (elInputTeam1) {
        elInputTeam1.onchange = function () {
            var v = parseInt(elInputTeam1.value, 10);
            var clamped = isNaN(v) ? 0 : clamp(v);
            if (currentSwap === 1) { score2 = clamped; }
            else                   { score1 = clamped; }
            updateScoreDisplay();
            sendPartialScore();
        };
    }
    if (elInputTeam2) {
        elInputTeam2.onchange = function () {
            var v = parseInt(elInputTeam2.value, 10);
            var clamped = isNaN(v) ? 0 : clamp(v);
            if (currentSwap === 1) { score1 = clamped; }
            else                   { score2 = clamped; }
            updateScoreDisplay();
            sendPartialScore();
        };
    }

    /* -------------------------------------------------------------------------
       AC1, AC4 (E61S03): Swap button handler — relative toggle.
       Increments the persisted swap offset (mod 2) and re-applies the visual swap
       to the currently shown match without reloading. Score bindings unchanged.
       --------------------------------------------------------------------- */

    if (elSwapBtn) {
        elSwapBtn.onclick = function () {
            var current = loadSwapOffset();
            saveSwapOffset(1 - current);
            applySwap(currentSetIndex, currentIsTiebreak, currentTeam1Points, currentTeam2Points);
        };
    }

    /* -------------------------------------------------------------------------
       AC3 (E65S07): Tap-to-refresh button handler.
       When the operator taps the button after idle-timeout has fired:
       - Reset idleTimeoutFired flag so startPolling() is allowed again.
       - Hide tap-to-refresh panel; show no-match panel (loading state restored).
       - Call loadMatch() directly: if a match is now available it is shown;
         otherwise the no-match/waiting state is re-entered and polling + idle timer restart.
       DEC-19: ES5 named event handler assignment.
       --------------------------------------------------------------------- */

    if (elTapToRefreshBtn) {
        elTapToRefreshBtn.onclick = function () {
            idleTimeoutFired = false;
            if (elTapToRefreshPanel) { vvwtHide(elTapToRefreshPanel); }
            vvwtShow(elNoMatchPanel);
            loadMatch();
        };
    }

    /* -------------------------------------------------------------------------
       AC2 (E65S07): Page Visibility API — pause polling when hidden, resume when visible.
