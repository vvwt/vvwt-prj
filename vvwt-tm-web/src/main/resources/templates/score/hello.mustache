<!DOCTYPE html>
<html lang="{{locale}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <!-- E44S02 AC3: VVW blue hex-icon favicon links — SVG first, PNG largest-to-smallest (AC7) -->
    <link rel="icon" type="image/svg+xml" href="/score/vvw-icon-blue.svg">
    <link rel="icon" type="image/png" sizes="256x256" href="/score/vvw-favicon-blue-256.png">
    <link rel="icon" type="image/png" sizes="128x128" href="/score/vvw-favicon-blue-128.png">
    <link rel="icon" type="image/png" sizes="64x64" href="/score/vvw-favicon-blue-64.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/score/vvw-favicon-blue-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/score/vvw-favicon-blue-16.png">
    <style>
        /* Minimal reset — iOS 9 Safari compatible; no flexbox/grid to avoid quirks */
        body { margin: 0; padding: 16px; font-family: Arial, sans-serif; font-size: 16px; background: #f4f4f4; }
        h1   { font-size: 1.4em; color: #333; }
        p    { color: #555; }
        #error-banner { display: none; background: #c0392b; color: #fff; padding: 10px; margin-bottom: 10px; border-radius: 4px; }
    </style>
</head>
<body>
    <!-- E44S02 AC5: VVW brand lockup — score-tablet header strip (DEC-19 ES5 carve-out: HTML-only, no JS) -->
    <!-- AC13: width="120" ensures minimum 120px render size per Brief C-9 -->
    <div style="padding: 8px 16px; background: #fff; border-bottom: 1px solid #ddd;">
        <img src="/score/vvw-tm-logo.svg" alt="Tournament Manager" width="120">
    </div>

    <!-- E06S02 AC8: global error banner — shown by window.onerror in vvwt-tablet.js -->
    <div id="error-banner"></div>

    <h1>{{heading}}</h1>
    <p>{{description}}</p>
    <p><small>{{versionLabel}}: {{appVersion}}</small></p>

    <!--
        E06S02 AC4 (ES5 utility script) + AC7 (no Svelte contamination):
        Only the shared ES5 utility script is loaded on scoring tablet pages.
        DEC-19: scoring tablet surface uses Mustache + ES5 only.
    -->
    <script src="/score/assets/vvwt-tablet.js"></script>
</body>
</html>
