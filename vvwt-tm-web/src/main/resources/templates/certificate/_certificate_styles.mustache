<style>
  /* ================================================================
     Plus Jakarta Sans — embedded as base64 WOFF2
     SIL Open Font License 1.1 — https://github.com/tokotype/PlusJakartaSans
     Two weights only: 700 (Bold) + 800 (ExtraBold)
     ================================================================ */
  @font-face {
    font-family: 'Plus Jakarta Sans';
    font-style: normal;
    font-weight: 700;
    font-display: block;
    src: url(data:font/woff2;base64,) format('woff2');
  }
  @font-face {
    font-family: 'Plus Jakarta Sans';
    font-style: normal;
    font-weight: 800;
    font-display: block;
    src: url(data:font/woff2;base64,) format('woff2');
  }

  :root { --ink:#0a1f3a; --blue:#1956a8; --yellow:#ffcb1f; --paper:#fafaf7; --line:#ece9e3; --muted:#7a7570; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: #e6e4dd; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; color: var(--ink); font-weight: 700; }
  body { display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 24px; }
  .stage { width: min(1180px, 100%); }

  .page {
    position: relative;
    background: var(--paper);
    aspect-ratio: 1684 / 1191;
    box-shadow: 0 12px 40px rgba(10,31,58,.18), 0 2px 6px rgba(10,31,58,.08);
    overflow: hidden;
    border-radius: 4px;
    container-type: inline-size;
    display: flex; flex-direction: column;
    padding: 3.537cqw 7cqw 2.830cqw;
    page-break-after: always;
    break-after: page;
  }

  .watermark {
    position: absolute; right: -22cqw; top: -22cqw; width: 60cqw; height: 60cqw; opacity: .04; z-index: 0; pointer-events: none;
  }

  .header { display: flex; justify-content: space-between; align-items: center; flex: 0 0 auto; position: relative; z-index: 2; }
  .lockup { display: flex; flex-direction: column; line-height: 1; }
  .lockup-row { display: flex; align-items: center; gap: 2px; font-weight: 800; font-size: 36px; letter-spacing: -1px; color: var(--ink); }
  .lockup-row .hex { width: 36px; height: 36px; display: block; margin: 0 1px; }
  .wm-tag  { font-weight: 700; font-size: 9px; letter-spacing: 2.6px; color: var(--blue); margin-top: 6px; text-transform: uppercase; }
  .meta { display: flex; gap: 36px; }

  .urkunde-badge { position: relative; display: inline-flex; align-items: center; justify-content: center; padding: 14px 28px; }
  .urkunde-badge .glow {
    position: absolute; inset: -8px;
    background: radial-gradient(ellipse at center,
      rgba(255, 203, 31, 0.55) 0%,
      rgba(255, 203, 31, 0.30) 35%,
      rgba(255, 203, 31, 0.10) 60%,
      rgba(255, 203, 31, 0)   100%);
    filter: blur(6px);
    z-index: 0;
  }
  .urkunde-badge .label {
    position: relative; z-index: 1;
    font-weight: 800;
    font-size: 28px;
    letter-spacing: 6px;
    color: var(--ink);
  }

  .divider { height: 1px; background: var(--line); margin: 0.424cqw 0 0; flex: 0 0 auto; position: relative; z-index: 1; }

  .hero { text-align: center; flex: 0 0 auto; position: relative; z-index: 2; margin-top: 0.354cqw; }
  .hero-title {
    font-weight: 800;
    font-size: clamp(40px, 5cqw, 64px);
    letter-spacing: -.025em;
    line-height: 1;
    margin: 8px 0 0;
    color: var(--ink);
  }
  .hero-subtitle {
    font-weight: 700; font-size: 14px; color: var(--muted);
    letter-spacing: .3px; margin-top: 10px;
  }

  .placement { display: flex; align-items: center; gap: 28px; flex: 0 0 auto; position: relative; z-index: 2; margin-top: 0.424cqw; }
  .place-num {
    font-weight: 800; line-height: .8; color: var(--blue);
    letter-spacing: -.05em; font-size: clamp(64px, 7.5cqw, 110px);
    font-variant-numeric: tabular-nums;
  }
  .place-meta { flex: 1; min-width: 0; padding-bottom: 6px; }
  .place-meta .row { display: flex; align-items: baseline; gap: 18px; margin-bottom: 0.283cqw; }
  .place-meta .lbl { font-weight: 700; font-size: 13px; letter-spacing: 3.0px; color: var(--blue); }
  .place-meta .of  { font-weight: 700; font-size: 18px; color: var(--ink); letter-spacing: .2px; transform: translateY(0.566cqw); }
  .place-meta .accent { width: 56px; height: 3px; background: var(--yellow); margin-bottom: 12px; }
  .place-meta .team-name {
    font-weight: 800; letter-spacing: -.025em; line-height: 1.1;
    font-size: clamp(20px, 2.6cqw, 34px); text-wrap: balance;
  }

  .photo-wrap {
    flex: 1 1 auto;
    margin-top: 0.424cqw;
    position: relative;
    border-radius: 12px; overflow: hidden; border: 1px solid var(--line);
    box-shadow: 0 6px 20px rgba(10,31,58,.08);
    z-index: 2;
    min-height: 0;
  }
  .photo { width: 100%; height: 100%; object-fit: cover; display: block; }
  .photo-fade {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 60%, rgba(0,0,0,.32) 100%);
    pointer-events: none;
  }
  .stamp {
    position: absolute; right: 16px; bottom: 16px;
    width: 88px; height: 88px;
    transform: rotate(-8deg);
    opacity: .95;
  }

  .tom-inline { font-weight: 700; letter-spacing: .5px; color: var(--ink); }
  .tom-inline .o {
    font-size: 1em;
    display: inline-block;
    transform: translateY(-0.08em);
    color: var(--blue);
    margin: 0 0.5px;
  }

  .footer { display: flex; justify-content: space-between; font-size: 10px; letter-spacing: 1.6px; color: var(--muted); font-weight: 700; flex: 0 0 auto; margin-top: 0.424cqw; position: relative; z-index: 2; }

  @media print {
    body { background: white; padding: 0; display: block; min-height: 0; align-items: initial; justify-content: initial; }
    .stage { width: 297mm; }
    .page { box-shadow: none; border-radius: 0; width: 297mm; height: 210mm; aspect-ratio: auto; padding: 12mm 18mm 10mm; }
    .page:last-child { page-break-after: auto; break-after: auto; }
    @page { size: A4 landscape; margin: 0; }
  }
</style>
