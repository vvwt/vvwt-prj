<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.vvwt</groupId>
        <artifactId>vvwt-prj</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>vvwt-tm-web</artifactId>
    <name>VVW Tournament Manager — Web Application</name>
    <description>
        Tournament Manager V1 Spring Boot application.
        Hosts the application entry point, HTTP endpoints, persistence wiring (H2 + Flyway — E02S02),
        and all TM V1 server-side logic through later Epics.
        Distribution: fat JAR via jlink (DEC-15 primary), Docker (secondary).
        Architecture: DEC-7 rewrite, multi-tenant per DEC-5, DEC-14 persistence.
        Stories: E02S01 (scaffold), E02S02 (persistence), E02S03 (schema), E02S04 (default-tenant),
                 E02S05 (jlink), E03+ (domain logic), E05+ (UI surfaces).
    </description>

    <!-- ===================================================================
         Compile dependencies
         Versions managed by parent dependencyManagement — NO version pins here.
         DEC-10: all version coordinates live in parent POM; child modules MUST NOT pin.
         =================================================================== -->
    <dependencies>

        <!-- Spring Boot Web starter — provides embedded server, MVC, Jackson -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- H2 embedded database — DEC-14 persistence choice, version from Spring Boot BOM (AC1) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>

        <!-- Flyway schema migration — version from Spring Boot BOM (AC2) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Spring Data JDBC — CRUD-first persistence starter, DEC-14 choice (AC3)
             Chosen over JPA/Hibernate: lighter-weight, no auto-schema interference with Flyway,
             aligned with DEC-14's CRUD-first framing. JPA remains available for future Epics. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jdbc</artifactId>
        </dependency>

        <!-- Spring Boot Actuator — provides /actuator/health endpoint (AC5) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring Security — HTTP Basic auth for /admin/** and /api/** (E05S02)
             Version managed by Spring Boot BOM (DEC-10 — no version pin in child modules).
             Provides: SecurityFilterChain, BCryptPasswordEncoder, BasicAuthenticationEntryPoint. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Spring Security Test — TestRestTemplate withBasicAuth, @WithMockUser -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Validation — Bean Validation support (@Valid, @NotBlank, etc.) for REST API (E05S03 AC1)
             Version managed by Spring Boot BOM (DEC-10 — no version pin in child modules). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring WebSocket — STOMP over SockJS; provides SimpMessagingTemplate, WebSocket broker (E05S03)
             Version managed by Spring Boot BOM (DEC-10 — no version pin in child modules).
             Provides: @EnableWebSocketMessageBroker, SimpMessagingTemplate, WebSocketConfigurer. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- vvwt-slotopt-worker-lib — shared types + compute kernel for slot-optimization (DEC-4 V1 amendment, DEC-11)
             Compile scope: E04S02–E04S04 use worker-lib types in production code (RawPhaseDef,
             StructuralFingerprint, PacketSolver, LehmerCodec, VarietyScorer).
             Version managed by parent POM dependencyManagement (DEC-10). -->
        <dependency>
            <groupId>de.vvwt</groupId>
            <artifactId>vvwt-slotopt-worker-lib</artifactId>
        </dependency>

        <!-- Spring Boot Mustache starter — DEC-12 (Mustache engine), DEC-19 (scoring tablet surface)
             E06S02 AC1: Mustache library via parent POM dependencyManagement (BOM-managed via
             spring-boot-starter-mustache → jmustache). Library choice: jmustache (Apache-2.0, DEC-3).
             Version managed by Spring Boot BOM (DEC-10 — no version pin in child modules).
             Auto-configures MustacheViewResolver resolving from classpath:/templates/ (AC2). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mustache</artifactId>
        </dependency>

        <!-- Spring Modulith — bounded-context enforcement (DEC-21, E13S01).
             1.4.x line: matches SB 3.4.7 baseline (DEC-10 fallback period; upgrade to 2.x when SB → 4.x).
             spring-modulith-starter-core: ApplicationModules scanning + verify() test support.
             spring-modulith-starter-jpa: event-publication integration for future cross-context events.
             NOTE (E13S01): spring-modulith-events-jpa is EXCLUDED from spring-modulith-starter-jpa
             because it requires a jakarta.persistence.EntityManager which is not available in this
             JDBC-only project. Only the event API/core modules are included; JPA-backed event
             publication storage is deferred until JPA is introduced (future story).
             Versions managed by parent POM spring-modulith-bom (DEC-10 C-1 — no version pin here). -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>
        <!-- spring-modulith-core: compile-scope explicit dependency (E14S04).
             spring-modulith-starter-core brings spring-modulith-core as a runtime dependency only;
             PerTenantFlywayRunner uses ApplicationModules + ApplicationModule from this artifact at
             compile time to derive module-ordered Flyway locations (AC3, DEC-21). Explicit compile
             scope overrides the transitive runtime scope. No version pin — managed by parent BOM. -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-core</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-jpa</artifactId>
            <exclusions>
                <!-- spring-modulith-events-jpa auto-configures JpaEventPublicationRepository,
                     which requires EntityManager. This project uses Spring Data JDBC (not JPA) —
                     EntityManager is unavailable. Exclude to prevent ApplicationContext failure.
                     Consequence: Modulith JPA event publication is disabled; domain events can still
                     be published via ApplicationEventPublisher but won't be persisted in a JPA store.
                     Re-enable when JPA is introduced to this project. -->
                <exclusion>
                    <groupId>org.springframework.modulith</groupId>
                    <artifactId>spring-modulith-events-jpa</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- assertj-db: independent database-content verification for DAO integration tests.
             The DAO's own query methods must not be the evaluator of its own write path —
             assertj-db inspects table state directly via the DataSource. Version managed by
             parent POM (DEC-10 — no version pin here). -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-db</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- spring-modulith-test: provides @ApplicationModuleTest annotation (E14S06).
             Enables per-module Spring context bootstrapping in integration tests — only the
             module under test and its declared dependencies are loaded. Used by
             CrossTenantIsolationTest to bootstrap only the tenant context and prove
             cross-tenant isolation (DEC-20, DEC-21, DEC-22). Version managed by parent BOM. -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- jqwik: property-based testing framework (E21S11, DEC-22).
             Used for TimelineCalculationService invariant tests (AC-TDD-TimelineCalculationService-PROPERTY-BASED).
             Version managed by parent POM (DEC-10 — no version pin here). -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik-engine</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ===================================================================
         Build
         =================================================================== -->
    <build>
        <plugins>

            <!--
                frontend-maven-plugin: downloads a pinned Node.js to target/node/ and runs npm scripts.
                Story E05S01 — AC1, AC2, AC7 | DEC-2 (Svelte/Vite/TS) | Brief H-3 (Maven/npm integration choice).

                Implementation decision (Brief H-3): frontend-maven-plugin 1.15.1 selected over exec-maven-plugin
                (which would require system Node installation) and over a separate Maven module approach
                (unnecessary module proliferation). frontend-maven-plugin downloads a pinned Node.js binary
                to target/node/ so the build is reproducible without a system Node prerequisite.

                Phase assignment:
                  initialize   — install-node-and-npm: downloads Node.js 22 + npm 10 to target/node/
                  generate-resources — npm install: installs node_modules
                  generate-resources — npm run build: compiles SPA assets to src/main/ui/dist/

                AC7: if npm run build exits non-zero, the generate-resources phase fails with a non-zero
                Maven exit code and the npm error output is printed to the build log. No partial artifact
                is produced because maven-resources-plugin (below) only copies dist/ if it exists.
            -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <configuration>
                    <!-- Working directory: the npm project root relative to this module -->
                    <workingDirectory>src/main/ui</workingDirectory>
                    <!-- Install to target/node to keep project root clean; .gitignored via target/ -->
                    <installDirectory>target</installDirectory>
                </configuration>
                <executions>

                    <!-- Step 1: download pinned Node.js + npm to target/node/ -->
                    <execution>
                        <id>install-node-and-npm</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <!-- Version pinned in parent POM (${node.version}) — update there only. -->
                            <nodeVersion>${node.version}</nodeVersion>
                        </configuration>
                    </execution>

                    <!-- Step 2: npm install (resolves package-lock.json; reproducible) -->
                    <execution>
                        <id>npm-install</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>install</arguments>
                        </configuration>
                    </execution>

                    <!-- Step 3: npm run build → src/main/ui/dist/ -->
                    <execution>
                        <id>npm-build</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>

                    <!--
                        E07S05 — Display SPA build steps.
                        The display SPA lives in src/main/ui-display/ (separate npm project from
                        the admin SPA). We reuse the same frontend-maven-plugin instance but add
                        three additional <execution> blocks with distinct IDs, pointing the
                        workingDirectory at src/main/ui-display/.

                        The shared <configuration><installDirectory>target</installDirectory></configuration>
                        above means Node.js is already downloaded to target/node/ by the first execution;
                        these display executions reuse it without re-downloading.

                        DEC-2: Vite + Svelte + TypeScript, no SvelteKit.
                        DEC-16 / AC7: Vite produces only local asset paths (/display/assets/...) —
                        no CDN references. The integration test DisplayViewControllerIT verifies this.
                    -->

                    <!-- Step 4: npm install for display SPA -->
                    <execution>
                        <id>npm-install-display</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>src/main/ui-display</workingDirectory>
                            <arguments>install</arguments>
                        </configuration>
                    </execution>

                    <!-- Step 5: npm run build → src/main/ui-display/dist-display/ -->
                    <execution>
                        <id>npm-build-display</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>src/main/ui-display</workingDirectory>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>

                    <!-- Step 6: npm test (vitest) for display SPA unit tests (AC10 displayApi tests) -->
                    <execution>
                        <id>npm-test-display</id>
                        <phase>test</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>src/main/ui-display</workingDirectory>
                            <arguments>test</arguments>
                        </configuration>
                    </execution>

                    <!--
                        E11S03 — Timer SPA build steps.
                        The timer SPA lives in src/main/ui-timer/ (separate npm project).
                        Follows the same pattern as the display SPA (E07S05).

                        DEC-2: Vite + Svelte + TypeScript, no SvelteKit.
                        DEC-15 / AC1: Vite produces only local asset paths (/timer/assets/...) —
                        no CDN references. The integration test TimerViewControllerIT verifies this.
                    -->

                    <!-- Step 7: npm install for timer SPA -->
                    <execution>
                        <id>npm-install-timer</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>src/main/ui-timer</workingDirectory>
                            <arguments>install</arguments>
                        </configuration>
                    </execution>

                    <!-- Step 8: npm run build → src/main/ui-timer/dist-timer/ -->
                    <execution>
                        <id>npm-build-timer</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>src/main/ui-timer</workingDirectory>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>

                    <!-- Step 9: npm test (vitest) for timer SPA unit tests -->
                    <execution>
                        <id>npm-test-timer</id>
                        <phase>test</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>src/main/ui-timer</workingDirectory>
                            <arguments>test</arguments>
                        </configuration>
                    </execution>

                </executions>
            </plugin>

            <!--
                maven-resources-plugin: copy Vite dist/ → target/classes/static/admin/.
                Story E05S01 — AC2, AC3, AC6.

                Bound to process-resources phase (runs after generate-resources where npm build fires).
                This places the SPA assets in the Spring Boot classpath under static/admin/, so:
                  - Spring Boot ResourceHttpRequestHandler serves /admin/** from classpath:/static/admin/
                  - The thin JAR (tm-application-*.jar) produced by maven-dependency-plugin includes
                    target/classes/static/admin/, satisfying AC6 (jlink distribution includes SPA assets).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-spa-assets</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static/admin</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/ui/dist</directory>
                                    <!-- Disable Maven property filtering — SPA assets are binary/JS,
                                         not Maven-filtered templates. Filtering would corrupt JS bundles. -->
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>

                    <!--
                        E07S05 — copy display SPA assets → target/classes/static/display/.
                        Story E07S05 — AC7, AC8, DEC-16.

                        After npm-build-display produces src/main/ui-display/dist-display/, this
                        execution copies the Vite output to target/classes/static/display/ so:
                          - Spring Boot ResourceHttpRequestHandler serves /display/assets/** from
                            classpath:/static/display/assets/ (static resources, no controller needed)
                          - DisplayViewController forwards /display/overview to
                            classpath:/static/display/index.html (served as static resource)
                          - The jlink distribution (fat JAR) includes static/display/ for offline use
                            (DEC-16: no internet required — all assets bundled).

                        filtering=false: SPA assets are binary/JS; Maven property substitution would
                        corrupt hashed filenames (e.g. main.abc123.js → main.{project.version}.js).
                    -->
                    <execution>
                        <id>copy-display-spa-assets</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static/display</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/ui-display/dist-display</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>

                    <!--
                        E11S03 — copy timer SPA assets → target/classes/static/timer/.
                        Story E11S03 — AC1, DEC-15.

                        After npm-build-timer produces src/main/ui-timer/dist-timer/, this
                        execution copies the Vite output to target/classes/static/timer/ so:
                          - Spring Boot ResourceHttpRequestHandler serves /timer/assets/** from
                            classpath:/static/timer/assets/ (static resources, no controller needed)
                          - TimerViewController forwards /timer/{tournamentId} to
                            classpath:/static/timer/index.html (served as static resource)
                          - The jlink distribution (fat JAR) includes static/timer/ (DEC-15: self-host).

                        filtering=false: SPA assets are binary/JS; Maven property substitution would
                        corrupt hashed filenames (e.g. main.abc123.js → main.{project.version}.js).
                    -->
                    <execution>
                        <id>copy-timer-spa-assets</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static/timer</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/ui-timer/dist-timer</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- maven-clean-plugin: remove target/runtime before jlink to allow re-build.
                 jlink refuses to write to an existing output directory.
                 Bound to prepare-package phase (runs just before package). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>clean-runtime-dir</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/runtime</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- spring-boot-maven-plugin: repackage produces runnable fat JAR.
                 Main class: de.vvwt.tm.TournamentManagerApplication
                 classifier=exec: preserves the original (flat) jar at vvwt-tm-web-*.jar
                 so that Failsafe integration tests resolve test classpath correctly.
                 The executable fat jar is produced as vvwt-tm-web-*-exec.jar. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- maven-failsafe-plugin: runs *IT.java integration tests (AC5, AC6) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                exec-maven-plugin: invokes jlink directly from JAVA_HOME (AC1, AC2, DEC-15).
                Plugin choice rationale: maven-jlink-plugin was rejected because it
                adds all non-modular dependency JARs (H2, Spring Boot, Flyway, etc.) as
                automatic modules to the jlink module-path, which jlink rejects.
                The exec-maven-plugin approach (AC1 option 3) calls jlink with the
                module-path pointing ONLY at JAVA_HOME/jmods, producing a JDK-platform-only
                custom JRE. Application and library JARs are placed on the classpath
                at runtime (not linked into the JRE).
                Module list derived from jdeps analysis (AC2, AC7).
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>create-runtime-image</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <!--
                                Use JAVA_HOME/bin/jlink — the same JDK Maven runs with.
                                This ensures the custom JRE matches the compilation target (Java 21).
                                AC2: jlink from java.home property resolves to Maven's JDK.
                            -->
                            <executable>${java.home}/bin/jlink</executable>
                            <arguments>
                                <!-- Module path: ONLY JDK platform modules (JAVA_HOME/jmods) -->
                                <argument>--module-path</argument>
                                <argument>${java.home}/../jmods</argument>
                                <!-- JDK modules for Spring Boot 3.4.7 + H2 + Flyway + Tomcat.
                                     Source: jdeps analysis with ignore-missing-deps, multi-release 21.
                                     Validated: custom JRE runs the application, health 200 OK (AC2, AC7) -->
                                <argument>--add-modules</argument>
                                <argument>java.base,java.compiler,java.desktop,java.instrument,java.net.http,java.prefs,java.rmi,java.scripting,java.security.jgss,java.sql.rowset,jdk.jfr,jdk.management,jdk.net,jdk.unsupported</argument>
                                <!-- Minimize JRE size (AC6) -->
                                <argument>--strip-debug</argument>
                                <argument>--no-header-files</argument>
                                <argument>--no-man-pages</argument>
                                <!-- Output to target/runtime/ — picked up by assembly descriptor (AC3) -->
                                <argument>--output</argument>
                                <argument>${project.build.directory}/runtime</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- maven-dependency-plugin: collect runtime JARs to target/lib/ (AC3) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <!-- Copy all transitive runtime dependency JARs to target/lib/ -->
                    <execution>
                        <id>copy-runtime-deps</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                            <excludeTransitive>false</excludeTransitive>
                        </configuration>
                    </execution>
                    <!-- Copy the thin application JAR (no classifier) as tm-application-<version>.jar.
                         The thin jar contains only our classes; deps are on the classpath via lib/.
                         NOT the exec (fat) jar — that is only for direct java -jar usage. -->
                    <execution>
                        <id>copy-app-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>${project.groupId}</groupId>
                                    <artifactId>${project.artifactId}</artifactId>
                                    <version>${project.version}</version>
                                    <type>jar</type>
                                    <!-- No classifier — copies the plain Maven jar (not the exec repackage) -->
                                    <outputDirectory>${project.build.directory}/lib</outputDirectory>
                                    <destFileName>tm-application-${project.version}.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- maven-assembly-plugin: packages runtime + lib + scripts into tar.gz (AC3, AC12) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>create-distribution-archive</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/main/assembly/distribution.xml</descriptor>
                            </descriptors>
                            <!-- Produces tournament-manager-<version>.tar.gz (AC3) -->
                            <finalName>tournament-manager-${project.version}</finalName>
                            <!-- appendAssemblyId=false: no "-distribution" suffix in filename -->
                            <appendAssemblyId>false</appendAssemblyId>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
