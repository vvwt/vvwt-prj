  pi-display/pom.xml — Maven module for the Raspberry Pi kiosk display provisioning.

  This module has no Java sources (packaging=pom). It binds shellcheck and bats-core
  invocations to the Maven integration-test phase via exec-maven-plugin so that
  mvn verify from the project root exercises the pi-display shell-test surface
  as part of the canonical DEC-54 build gate.

  Related DECs: DEC-10 (Maven multi-module structure), DEC-22 (TDD / RED-first),
                DEC-54 (mvn verify canonical build gate), DEC-75 (AGPL-3.0-or-later),
                DEC-3 (open-source only — exec-maven-plugin Apache-2.0, shellcheck GPL-3.0,
                bats MIT, all AGPL-forward-compatible per FSF matrix).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.vvwt</groupId>
        <artifactId>vvwt-prj</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>pi-display</artifactId>
    <packaging>pom</packaging>

    <name>vvwt-prj — Pi Display Provisioning</name>
    <description>
        Raspberry Pi kiosk display provisioning module.
        Contains build-image.sh (FullPageOS 0.14.0 overlay wrapper) and its bats test suite.
        No Java sources. Shell tests are bound to the Maven integration-test phase via
        exec-maven-plugin so that mvn verify covers this surface per DEC-54.
    </description>

    <!--
        No &lt;dependencies&gt; block — this module has no Java code.
        shellcheck and bats are host tools invoked by exec-maven-plugin.
        Dependency licenses (informational, verified AGPL-forward-compatible per FSF matrix):
          - exec-maven-plugin 3.5.0: Apache-2.0
          - shellcheck 0.9.0:        GPL-3.0
          - bats-core 1.x / 1.13.0:  MIT (npm bats)
    -->

    <build>
        <plugins>
            <!--
                maven-enforcer-plugin — host-prereq enforcement (E69S09 / DEC-79 origin-incident closure).

                Binds to the validate phase (the FIRST Maven lifecycle phase) so that the enforcer
                rule fires BEFORE the exec-maven-plugin integration-test invocations of shellcheck
                and bats. On a host missing either tool, the build fails immediately with a clear
                [ERROR] naming the missing executable — not an opaque "Cannot run program: error=2"
                from exec-maven-plugin.

                Implementation: uses maven-enforcer-plugin EvaluateBeanshell rule to invoke
                'which shellcheck' and 'which bats' via Runtime.exec(), evaluating to false
                (triggering enforcer FAIL) when either tool is absent. BeanShell is bundled with
                enforcer-rules 3.5.0 (BSF dependency). The plugin version is inherited from parent
                POM pluginManagement (no <version> tag — DEC-10 / AC7).

                Related DECs: DEC-79 (host-environment-integrity prohibition), DEC-10 (Maven
                multi-module), DEC-3 (open-source only — maven-enforcer-plugin Apache-2.0).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-host-prereqs-pi-display</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <evaluateBeanshell>
                                    <condition><![CDATA[
                                        // E69S09/DEC-79: requireExecutable-equivalent guard for shellcheck.
                                        // Verifies shellcheck is on PATH before integration-test invocations.
                                        // On a host without shellcheck, exec-maven-plugin emits a confusing
                                        // "Cannot run program: error=2" — this guard fails fast with an actionable message.
                                        // DEC-79 Clause A: agents MUST NOT self-install. Operators install; see README.md Host Prerequisites.
                                        Process p = Runtime.getRuntime().exec(new String[]{"which", "shellcheck"});
                                        int exit = p.waitFor();
                                        if (exit != 0) {
                                            throw new Exception("E69S09/DEC-79: 'shellcheck' not found on PATH. " +
                                                "Install before running mvn verify on pi-display. " +
                                                "Debian/Ubuntu: sudo apt install shellcheck | macOS: brew install shellcheck | " +
                                                "Fedora: sudo dnf install ShellCheck | Arch: sudo pacman -S shellcheck. " +
                                                "See pi-display/README.md Host Prerequisites section.");
                                        }
                                        return true;
                                    ]]></condition>
                                </evaluateBeanshell>
                                <evaluateBeanshell>
                                    <condition><![CDATA[
                                        // E69S09/DEC-79: requireExecutable-equivalent guard for bats.
                                        // DEC-79 Clause A: agents MUST NOT self-install. Operators install; see README.md Host Prerequisites.
                                        Process p = Runtime.getRuntime().exec(new String[]{"which", "bats"});
                                        int exit = p.waitFor();
                                        if (exit != 0) {
                                            throw new Exception("E69S09/DEC-79: 'bats' not found on PATH. " +
                                                "Install before running mvn verify on pi-display. " +
                                                "Debian/Ubuntu: sudo apt install bats | macOS: brew install bats-core | " +
                                                "npm: npm install -g bats | Fedora: sudo dnf install bats. " +
                                                "See pi-display/README.md Host Prerequisites section.");
                                        }
                                        return true;
                                    ]]></condition>
                                </evaluateBeanshell>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                exec-maven-plugin bound to the integration-test phase.
                Two executions:
                  1. shellcheck — lint all authored shell files under pi-display/
                  2. bats       — run the bats test suite
                Both executions use fail=true (default for exec:exec) so a non-zero exit
                propagates to non-zero mvn verify, satisfying DEC-54 §"Verdict semantics"
                binary-on-exit invariant.

                The plugin version is inherited from parent POM
                &lt;exec-maven-plugin.version&gt; (3.5.0 as of E69S01).
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <executions>

                    <!-- 1. shellcheck: lint build-image.sh and any future shell files -->
                    <execution>
                        <id>shellcheck-pi-display</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>shellcheck</executable>
                            <arguments>
                                <argument>${project.basedir}/build-image.sh</argument>
                            </arguments>
                            <workingDirectory>${project.basedir}</workingDirectory>
                        </configuration>
                    </execution>

                    <!-- 2. bats: run the build-image shell test suite (E69S01) -->
                    <execution>
                        <id>bats-pi-display</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>bats</executable>
                            <arguments>
                                <argument>${project.basedir}/src/test/sh/build-image.bats</argument>
                            </arguments>
                            <workingDirectory>${project.basedir}</workingDirectory>
                        </configuration>
                    </execution>

                    <!-- 3. bats: run the operator-runbook README content tests (E69S02) -->
                    <execution>
                        <id>bats-pi-display-readme</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>bats</executable>
                            <arguments>
                                <argument>${project.basedir}/src/test/sh/readme.bats</argument>
                            </arguments>
                            <workingDirectory>${project.basedir}</workingDirectory>
                        </configuration>
                    </execution>

                    <!-- 4. bats: run the maven-enforcer requireExecutable source-grep assertions (E69S09) -->
                    <execution>
                        <id>bats-pi-display-enforcer</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>bats</executable>
                            <arguments>
                                <argument>${project.basedir}/src/test/sh/enforcer.bats</argument>
                            </arguments>
                            <workingDirectory>${project.basedir}</workingDirectory>
                        </configuration>
                    </execution>

                </executions>
            </plugin>

            <!--
                Disable maven-surefire-plugin for this pom-packaging module (no Java tests).
                Without this, the default lifecycle binding runs surefire on nothing and
                emits a warning. Explicit skip is cleaner.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
