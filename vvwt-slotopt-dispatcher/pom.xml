<?xml version="1.0" encoding="UTF-8"?>
<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.vvwt</groupId>
        <artifactId>vvwt-prj</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>vvwt-slotopt-dispatcher</artifactId>
    <name>VVW Slot-Opt Dispatcher</name>
    <description>
        Spring Boot dispatcher service for the slot-optimization subsystem.
        Provides the DEC-6 keypair registration and packet dispatch endpoints.
        Algorithm-agility SPI (SignatureVerifier) per DEC-43 / E37S04.
        Depends on vvwt-slotopt-worker-lib for shared types.
        See DEC-10, DEC-11 (module structure), DEC-35 (package layout), DEC-43 (algorithm-agility).
    </description>

    <dependencies>

        <!-- Worker-lib: shared type model (DEC-11) -->
        <dependency>
            <groupId>de.vvwt</groupId>
            <artifactId>vvwt-slotopt-worker-lib</artifactId>
        </dependency>

        <!-- Spring Boot web starter: embedded Tomcat + Spring MVC + Jackson -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot test starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- SB 4.x test module shim — provides @WebMvcTest, @DataJdbcTest, @AutoConfigureTestDatabase,
             TestRestTemplate, and other classic test slices split into separate modules in SB 4.x.
             Replaces the monolithic spring-boot-test-autoconfigure from SB 3.x (E42S01). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test-classic-modules</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- spring-boot-security (test scope) — required for @WebMvcTest in SB 4.x.
             The @WebMvcTest slice references SecurityAutoConfiguration at its new package path
             (org.springframework.boot.security.autoconfigure) even when the module does not
             use Spring Security in production; the class must be on the test classpath (E42S01). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-security</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- spring-security-test (test scope) — required for MockMvcConfiguration in SB 4.x
             spring-boot-webmvc-test. MockMvcConfiguration conditionally instantiates
             SecurityMockMvcRequestPostProcessors; the class must be resolvable even when
             the module does not use Spring Security in production (E42S01). -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- AssertJ — additional assertion support -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Data JDBC: persistence for identity package (E37S05 — DEC-35) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jdbc</artifactId>
        </dependency>

        <!-- Flyway: DB migrations for identity.V1__key_registration (E37S05 — DEC-26 analogous) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- spring-boot-flyway: SB 4.x auto-configuration module for Flyway.
             In SB 4.x, FlywayAutoConfiguration moved from spring-boot-autoconfigure to this
             dedicated module. Required so that @DataJdbcTest test slices (which reference
             FlywayAutoConfiguration via @ImportAutoConfiguration) can resolve the class (E42S01). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <!-- H2: in-memory DB for standalone process startup and IT (runtime scope — E63S08).
             The dispatcher's application.yml declares H2 as the default datasource; H2 must
             therefore be on the runtime classpath so the fat JAR can start standalone.
             Previously test-scoped (E37S05), which silently excluded H2 from the fat JAR
             and prevented the dispatcher from starting as a subprocess in E2E tests.
             Runtime scope ensures H2 is bundled in the fat JAR (AC-ERR-E2E-EXPOSED-DEFECT-SURFACED). -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- assertj-db: independent persistence verifier for DAO IT (DEC-26 Rule 2, E37S05) -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-db</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- jackson-datatype-jsr310 (test scope) — Jackson 2.x JavaTimeModule for LocalDate
             serialization in unit tests that construct ObjectMapper directly (AnnouncedAlgorithmTest).
             SB 4.x uses Jackson 3.x as primary; the 2.x jsr310 module is retained in BOM for
             backward-compat but must be declared explicitly when the test does not go through
             Spring auto-configuration (E42S01). -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit JUnit 5 — build-time interface-mandate enforcement guard (E57S05, DEC-72 Clause E-ext).
             Asserts every self-created Spring component is addressable through a public first-party interface.
             Apache 2.0 license — OSS-compliant per DEC-3. Version managed by parent pom (archunit.version). -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
        </dependency>

        <!-- vvwt-slotopt-standalone-worker (test scope, tests classifier) — E60S05 E2E harness.
             Provides WorkerLauncher + WorkerRunResult from the integration test-jar of the
             standalone worker. The test-jar (classifier=tests) is produced by the
             maven-jar-plugin test-jar execution in vvwt-slotopt-standalone-worker/pom.xml.
             Test scope only: dispatcher MUST NOT have a production/runtime dep on the standalone
             worker (DEC-11 service boundary). Enforcer rule in vvwt-slotopt-standalone-worker
             bans the reverse dep (standalone → dispatcher), not this direction.
             AC-GOV-NO-MODULE-BOUNDARY-BREACH: test code only, no production compile dep.
             The non-classifier (main) artifact is also declared below for runtime transitive deps. -->
        <dependency>
            <groupId>de.vvwt</groupId>
            <artifactId>vvwt-slotopt-standalone-worker</artifactId>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>

        <!-- vvwt-slotopt-standalone-worker main artifact (test scope) — required so that the
             transitive compile dependencies of the worker (worker-lib, worker-runtime, etc.)
             are available in the test classpath when WorkerLauncher is invoked. The test-jar
             does not carry transitive deps; the main artifact does. -->
        <dependency>
            <groupId>de.vvwt</groupId>
            <artifactId>vvwt-slotopt-standalone-worker</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- maven-surefire-plugin: include E2E IT tests from the e2e package.
                 E60S05: LiveWorkerE2EIT uses @SpringBootTest(RANDOM_PORT) — the same
                 mechanism as AlgorithmAnnouncementIT and other Spring slice tests in this
                 module. Surefire runs these in-process (no forked JVM classpath issues
                 that arise with the Spring Boot fat-jar + failsafe forked JVM).
                 Pre-existing *IT.java tests in other packages were already silently excluded
                 by surefire's default exclusion pattern; this entry adds only the e2e package.
                 Version from parent pluginManagement (maven-surefire-plugin.version). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/e2e/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
