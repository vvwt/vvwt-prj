<?xml version="1.0" encoding="UTF-8"?>
<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.vvwt</groupId>
        <artifactId>vvwt-prj</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>vvwt-slotopt-dispatcher</artifactId>
    <name>VVW Slot-Opt Dispatcher</name>
    <description>
        Spring Boot dispatcher service for the slot-optimization subsystem.
        Provides the DEC-6 keypair registration and packet dispatch endpoints.
        Algorithm-agility SPI (SignatureVerifier) per DEC-43 / E37S04.
        Depends on vvwt-slotopt-worker-lib for shared types.
        See DEC-10, DEC-11 (module structure), DEC-35 (package layout), DEC-43 (algorithm-agility).
    </description>

    <dependencies>

        <!-- Worker-lib: shared type model (DEC-11) -->
        <dependency>
            <groupId>de.vvwt</groupId>
            <artifactId>vvwt-slotopt-worker-lib</artifactId>
        </dependency>

        <!-- Spring Boot web starter: embedded Tomcat + Spring MVC + Jackson -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot test starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- AssertJ — additional assertion support -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
