<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.vvwt</groupId>
        <artifactId>vvwt-prj</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>vvwt-benchmark</artifactId>
    <name>VVW Benchmark</name>
    <description>
        JMH benchmark module — H-2 performance ship-gate (E01S12).
        Isolated from production dependencies.
        Gated behind the 'benchmark' Maven profile so ordinary
        'mvn install' does NOT build or run benchmarks.
        Only 'mvn install -Pbenchmark' activates this module.
    </description>

    <!-- This module only participates in the reactor under the 'benchmark' profile.
         The parent pom.xml lists it in <modules>, but the activeByDefault=false
         profile below means it is skipped unless -Pbenchmark is passed.
         IMPORTANT: The module IS listed in parent <modules> unconditionally —
         Maven requires this for the reactor to find the module. The profile
         gate controls whether the module's lifecycle phases actually run. -->

    <!-- ===================================================================
         Compile dependencies (active only within this module's build)
         Versions managed by parent dependencyManagement.
         =================================================================== -->
    <dependencies>

        <!-- Own worker-lib (the subject of the benchmarks) -->
        <dependency>
            <groupId>de.vvwt</groupId>
            <artifactId>vvwt-slotopt-worker-lib</artifactId>
        </dependency>

        <!-- JMH runtime -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
        </dependency>

        <!-- JMH annotation processor (generates benchmark boilerplate) -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <!-- ===================================================================
         Profiles
         =================================================================== -->
    <!-- ===================================================================
         Build: module-level PMD CPD skip (DEC-22 JMH carve-out, DEC-78 §Layer-C).
         JMH annotation processor generates benchmark boilerplate into
         target/generated-sources/annotations/ that is not first-party authored code.
         The generated files (KernelThroughputBenchmark_*_jmhTest.java, etc.) contain
         intentionally repeated scaffolding patterns that CPD flags but that cannot
         be suppressed via excludeFromFailureFile (generated class names, not authored).
         Skipping CPD for this module is correct: DEC-22 §JMH-carve-out explicitly
         exempts benchmark modules from the TDD Iron Law; DEC-78 §Layer-C applies the
         same carve-out to DRY-lexical detection. Only first-party authored sources
         are within DEC-78 scope; generated annotation-processor output is not.
         E70S01 activation, 2026-05-31.
         =================================================================== -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>

        <!-- Benchmark profile gate: compile and shade only when -Pbenchmark is passed -->
        <profile>
            <id>benchmark</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>

                    <!-- JMH self-contained benchmark JAR via maven-shade-plugin
                         (per JMH manual: produces benchmarks.jar in target/) -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>create-benchmark-jar</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <configuration>
                                    <finalName>benchmarks</finalName>
                                    <transformers>
                                        <transformer implementation=
                                            "org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                            <mainClass>org.openjdk.jmh.Main</mainClass>
                                        </transformer>
                                        <transformer implementation=
                                            "org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                    </transformers>
                                    <filters>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                            </excludes>
                                        </filter>
                                    </filters>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>

        <!-- Ship-gate profile (E01S12 AC7): run gate/run-gate.sh on reference hardware.
             This profile MUST be activated when building the H-2 ship-gate for Phase 1 release.
             Usage: mvn -Pbenchmark,ship-gate package -pl vvwt-benchmark -am -DskipTests
             Then:  cd vvwt-benchmark && ./gate/run-gate.sh
             See RELEASE-CHECKLIST.md for the full ship-gate procedure. -->
        <profile>
            <id>ship-gate</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <!-- ship-gate is a documentation/process marker — no additional build steps.
                 The actual gate logic lives in gate/run-gate.sh (AC5, AC8). -->
        </profile>

    </profiles>

</project>
