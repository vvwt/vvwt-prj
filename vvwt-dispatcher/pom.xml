<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.vvwt</groupId>
        <artifactId>vvwt-prj</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>vvwt-dispatcher</artifactId>
    <name>VVW Dispatcher</name>
    <description>
        Spring Boot service: worker identity registry, job intake, packet decomposition
        and distribution, result intake and finalization.
        Stories: E01S06, E01S07, E01S08, E01S09 (DB cache layer).
        Signature verification uses the same JDK 21 native Ed25519 path as worker-lib
        (transitively — the dispatcher does NOT add its own crypto dependency).
    </description>

    <!-- ===================================================================
         Compile dependencies
         Versions managed by parent dependencyManagement.
         =================================================================== -->
    <dependencies>

        <!-- Own worker-lib (brings in Ed25519 capability + type model) -->
        <dependency>
            <groupId>de.vvwt</groupId>
            <artifactId>vvwt-worker-lib</artifactId>
        </dependency>

        <!-- Spring Boot starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC driver (production DB) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ===================================================================
         Build
         =================================================================== -->
    <build>
        <plugins>

            <!-- spring-boot-maven-plugin: repackage produces runnable fat JAR.
                 Main class: de.vvwt.dispatcher.DispatcherApplication (delivered by E01S06). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
