<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.vvwt</groupId>
        <artifactId>vvwt-prj</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>vvwt-info-server</artifactId>
    <name>VVW Info — Server Application</name>
    <description>
        Public Participant Info Service Spring Boot application (DEC-42 D1).
        REST publisher endpoints, WebSocket reader, HTTP-poll fallback, persistence,
        signature verification, and registration handshake.
        Profile-driven: self-host (H2, default, no-config) / primary (PostgreSQL, opt-in).
        DEC-42 D3: no-config default = self-host = drive-by-squatting mitigation.
        Stories: E38S01 (scaffold), E38S02+ (domain logic).
    </description>

    <!-- ===================================================================
         Compile dependencies (versions from parent BOM — DEC-10)
         =================================================================== -->
    <dependencies>

        <!-- Spring Boot Web starter — embedded server + MVC + Jackson -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot WebSocket starter — WS reader endpoint (E38S06 AC7) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- Spring Boot Data JDBC — CRUD persistence (DEC-42 D4, NOT JPA) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jdbc</artifactId>
        </dependency>

        <!-- Spring Boot Validation — Bean Validation for request DTOs -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Flyway schema migration (DEC-42 D4 — profile-driven H2/PostgreSQL) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Flyway PostgreSQL support (Spring Boot 3.3+ requires explicit DB-specific module) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- H2 embedded database — default (self-host) profile runtime dep (DEC-42 D4) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- PostgreSQL JDBC driver — primary profile runtime dep.
             optional=true: excluded from transitive dependency graph; activated by
             spring.profiles.active=primary at runtime (DEC-42 D4).
             Version from Spring Boot BOM (DEC-10). -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- vvwt-info-dto — the typed DTO contract for publisher and reader endpoints.
             Version managed by parent dependencyManagement (DEC-10). -->
        <dependency>
            <groupId>de.vvwt</groupId>
            <artifactId>vvwt-info-dto</artifactId>
        </dependency>

        <!-- Flyway auto-configuration — Spring Boot 4.x split module (E42S01).
             In SB 4.x, Flyway auto-configuration was extracted from spring-boot-autoconfigure
             into the standalone spring-boot-flyway module. Without this dependency, Flyway
             auto-configuration is absent from the context and migrations are not applied. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <!-- Jackson 2.x compat bridge — Spring Boot 4.x / Jackson 3.x migration (E42S01).
             spring-boot-jackson2 registers Jackson2AutoConfiguration which provides the
             com.fasterxml.jackson.databind.ObjectMapper bean. Required because production code
             in this module injects com.fasterxml.jackson.databind.ObjectMapper (Jackson 2.x API).
             spring-boot-starter-web pulls only spring-boot-jackson (Jackson 3.x); without this
             explicit dependency the ObjectMapper bean is not registered and context startup fails. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>

        <!-- Caffeine — per-IP token-bucket cache backing for rate-limiting (E38S07 AC8).
             Apache 2.0 license — OSS-compliant per DEC-3. Version managed by parent BOM.
             AC8: all transitive runtime deps verified OSI-approved OSS. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- RFC 8785 JCS canonical JSON — server-side signature payload canonicalization.
             AC8 (E38S05): both server (this module) and TM publisher (E38S09) MUST agree
             on byte-identical JCS output. Cross-implementation byte-stability validated by
             JcsCrossImplByteStabilityIT. Apache 2.0 per DEC-3. -->
        <dependency>
            <groupId>io.github.erdtman</groupId>
            <artifactId>java-json-canonicalization</artifactId>
        </dependency>

        <!-- ===================================================================
             Test dependencies (versions from parent BOM — DEC-10)
             =================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- SB 4.x test module shim — provides @WebMvcTest, @DataJdbcTest, @AutoConfigureTestDatabase,
             TestRestTemplate, and other classic test slices split into separate modules in SB 4.x.
             Replaces the monolithic spring-boot-test-autoconfigure from SB 3.x (E42S01). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test-classic-modules</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- spring-boot-security (test scope) — required for @AutoConfigureMockMvc in SB 4.x.
             spring-boot-test-classic-modules transitively pulls spring-boot-security-test, which
             adds SecurityAutoConfiguration etc. to @AutoConfigureMockMvc.imports. Those classes
             live in spring-boot-security; without it, ApplicationContext load fails with
             FileNotFoundException (E42S01).
             The default security behaviour (basic-auth, CSRF) is overridden by
             InfoServerTestSecurityConfig (permit-all SecurityFilterChain) in test sources. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-security</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- spring-security-test — provides SecurityMockMvcRequestPostProcessors for MockMvc tests.
             In SB 4.x, SecurityMockMvcAutoConfiguration (from spring-boot-security-test) references
             SecurityMockMvcRequestPostProcessors at instantiation time; without spring-security-test
             on the classpath the MockMvc bean creation fails with NoClassDefFoundError (E42S01). -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- spring-boot-restclient — provides RestTemplateBuilder, required by
             TestRestTemplateTestAutoConfiguration (from spring-boot-resttestclient autoconfigure).
             Without this dependency, @AutoConfigureTestRestTemplate context initialization fails
             with ClassNotFoundException: RestTemplateBuilder (E42S01). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- spring-boot-resttestclient — provides TestRestTemplate for RANDOM_PORT IT tests.
             In SB 4.x, TestRestTemplate moved to spring-boot-resttestclient. Without this dependency,
             @Autowired TestRestTemplate injection fails with NoSuchBeanDefinitionException (E42S01). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- assertj-db — independent persistence verifier for DAO ITs (DEC-26/DEC-46 Rule 2).
             Version managed by parent dependencyManagement. -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-db</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers — PostgreSQL 16 ITs for dual-backend testing (AC3, DEC-3).
             Versions managed by testcontainers-bom in parent (TC 2.x artifact IDs; E42S01). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit JUnit 5 — build-time interface-mandate enforcement guard (E57S05, DEC-72 Clause E-ext).
             Asserts every self-created Spring component is addressable through a public first-party interface.
             Apache 2.0 license — OSS-compliant per DEC-3. Version managed by parent pom (archunit.version). -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
        </dependency>

    </dependencies>

    <!-- ===================================================================
         Build plugins
         =================================================================== -->
    <build>
        <plugins>

            <!-- Spring Boot application repackage — produces executable fat JAR.
                 classifier=exec preserves the original skinny JAR so that maven-failsafe-plugin
                 can resolve classes from target/classes without unpacking BOOT-INF/. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Maven Failsafe — integration tests (*IT.java) run at verify phase.
                 Required for BannedDependenciesEnforcerIT.java (AC9). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                Maven Enforcer Plugin — bannedDependencies rules (DEC-42 D2, AC6).

                RULE: vvwt-info-server MUST NOT depend on any TM or slotopt modules.
                The only allowed cross-subsystem dependency edge is:
                  vvwt-tm-web → vvwt-info-dto  (not the other direction).

                Bans at compile and runtime scope (functional_scope: default = all scopes).
                Enforcer 3.5.0 managed by parent pluginManagement (DEC-10).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-banned-deps-info-server</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <!-- TM modules — only vvwt-info-dto is the allowed edge, not the reverse -->
                                        <exclude>de.vvwt:vvwt-tm-web</exclude>
                                        <exclude>de.vvwt:vvwt-tm-*</exclude>
                                        <!-- Slotopt modules -->
                                        <exclude>de.vvwt:vvwt-worker-*</exclude>
                                        <exclude>de.vvwt:vvwt-slotopt-worker-lib</exclude>
                                        <exclude>de.vvwt:vvwt-slotopt-dispatcher</exclude>
                                        <exclude>de.vvwt:vvwt-slotopt-*</exclude>
                                        <exclude>de.vvwt:vvwt-dispatcher</exclude>
                                        <exclude>de.vvwt:vvwt-standalone-worker</exclude>
                                        <exclude>de.vvwt:vvwt-benchmark</exclude>
                                    </excludes>
                                    <searchTransitive>true</searchTransitive>
                                    <message>DEC-42 D2: vvwt-info-server MUST NOT depend on TM, worker, dispatcher, slotopt, or benchmark modules. The only cross-subsystem dependency is vvwt-tm-web → vvwt-info-dto.</message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
