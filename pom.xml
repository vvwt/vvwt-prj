<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.vvwt</groupId>
    <artifactId>vvwt-prj</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>VVW Tournaments — Next Generation</name>
    <description>
        Parent POM for the vvwt-prj Maven multi-module project.
        Contains the slot-optimization service components (Phase 1) and
        will grow to include Tournament Manager modules in future epics.
        See DEC-10 (multi-module structure) and DEC-11 (submodule mapping).
    </description>

    <!-- Phase-1 modules (slot-optimization service) — DEC-10, DEC-11 -->
    <modules>
        <module>vvwt-slotopt-worker-lib</module>
        <module>vvwt-slotopt-dispatcher</module>
        <module>vvwt-slotopt-standalone-worker</module>
        <module>vvwt-benchmark</module>

        <!-- Tournament Manager modules (E02+) — DEC-10, DEC-7 -->
        <module>vvwt-tm-web</module>

        <!-- Public Participant Info Service modules (E38+) — DEC-42, DEC-10 -->
        <module>vvwt-info-dto</module>
        <module>vvwt-info-server</module>
        <module>vvwt-info-client</module>
    </modules>

    <!-- ===================================================================
         Properties
         =================================================================== -->
    <properties>
        <!-- Java 21 baseline (DEC-10; active Spring Boot 4.x baseline as of E42S01) -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Dependency versions managed centrally -->
        <!-- Spring Boot 4.0.6 — active baseline per DEC-10 §Decision "highest available 4.x release".
             4.0.5 named in DEC-10 title; 4.0.6 satisfies the clause without DEC-10 amendment.
             Delivered as E42S01 (2026-05-01). -->
        <spring-boot.version>4.0.6</spring-boot.version>

        <!-- JUnit 5 / test -->
        <junit-bom.version>5.12.2</junit-bom.version>
        <mockito.version>5.17.0</mockito.version>
        <assertj.version>3.27.3</assertj.version>
        <assertj-db.version>3.0.2</assertj-db.version>
        <jqwik.version>1.9.3</jqwik.version>

        <!-- ArchUnit — build-time architecture tests (E57S05 — DEC-72 Clause E-ext enforcement guard).
             Apache 2.0 license — OSS-compliant per DEC-3.
             archunit-junit5: JUnit 5 integration for @Test-based architecture rules.
             Version centralised here; child modules declare test-scoped dep without version. -->
        <archunit.version>1.4.1</archunit.version>

        <!-- Logging -->
        <slf4j.version>2.0.17</slf4j.version>

        <!-- Standalone worker CLI -->
        <picocli.version>4.7.6</picocli.version>

        <!-- JMH (benchmark) -->
        <jmh.version>1.37</jmh.version>

        <!-- Database -->
        <postgresql.version>42.7.5</postgresql.version>
        <h2.version>2.4.240</h2.version>

        <!-- Testcontainers 2.0.5 — BOM-aligned with Spring Boot 4.0.6 (spring-boot-dependencies-4.0.6.pom
             pins testcontainers 2.0.5). Used for PostgreSQL ITs in vvwt-info-server (DEC-3 OSS-compliant).
             Bumped by E42S01 from 1.20.6; 1.x → 2.x major version aligned with SB 4.x BOM. -->
        <testcontainers.version>2.0.5</testcontainers.version>

        <!-- RFC 8785 JCS canonical JSON — E38S05/E38S09 publisher signature payload.
             Apache 2.0 — OSS-compliant per DEC-3. Pinned to 1.1 (stable, Java 8+, no deps). -->
        <java-json-canonicalization.version>1.1</java-json-canonicalization.version>

        <!-- Caffeine in-memory cache — E38S07 rate-limiting per-IP token-bucket backing.
             Apache 2.0 license — OSS-compliant per DEC-3.
             3.2.x: Java 11+ compatible; 3.2.0 stable for Java 21. No non-OSS transitive deps.
             AC8 (E38S07): all transitive runtime deps verified OSI-approved OSS. -->
        <caffeine.version>3.2.0</caffeine.version>

        <!-- Plugin versions -->
        <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.5.3</maven-failsafe-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <maven-shade-plugin.version>3.6.0</maven-shade-plugin.version>
        <maven-clean-plugin.version>3.4.1</maven-clean-plugin.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <jacoco-maven-plugin.version>0.8.13</jacoco-maven-plugin.version>

        <!-- jlink distribution plugins (E02S05 — DEC-15) -->
        <!-- exec-maven-plugin: used to invoke jlink directly (maven-jlink-plugin cannot link
             non-modular Spring Boot/H2/Flyway JARs as automatic modules — see E02S05 impl-report) -->
        <exec-maven-plugin.version>3.5.0</exec-maven-plugin.version>
        <maven-dependency-plugin.version>3.8.1</maven-dependency-plugin.version>
        <maven-assembly-plugin.version>3.7.1</maven-assembly-plugin.version>

        <!-- Frontend build plugin (E05S01 — DEC-2: Svelte/Vite npm build wired into Maven) -->
        <!-- frontend-maven-plugin: downloads pinned Node.js/npm to target/node/, runs npm scripts.
             Choice rationale: no system Node dependency in CI; well-supported Maven+npm bridge. -->
        <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
        <!-- Node.js version pinned here so it can be updated in one place. -->
        <node.version>v22.22.2</node.version>
        <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>

        <!-- Spring Modulith 2.0.6 — mandatory co-bump with Spring Boot 4.x per DEC-10 / DEC-21.
             2.x line pairs with SB 4.x; 1.4.6 was the SB 3.4.x provisional period (superseded by E42S01).
             E13S01 (DEC-21): Wave-1 foundation dependency for bounded-context enforcement. -->
        <spring-modulith.version>2.0.6</spring-modulith.version>

        <!-- Spotless + google-java-format (E18S02 — DEC-30): project-wide formatting +
             unused-import removal. AOSP style (4-space indent) chosen over GOOGLE (2-space)
             to minimize first-run reformat blast radius on existing codebase.
             spotless-maven-plugin 2.44.x: latest stable compatible with Java 21.
             google-java-format 1.19.x: matches JDK 21 AST support. -->
        <spotless-maven-plugin.version>2.44.3</spotless-maven-plugin.version>
        <google-java-format.version>1.19.2</google-java-format.version>

        <!-- HtmlUnit 4.x — headless browser for CSS-cascade + computed-style test assertions
             (E49S03 — DEC-19 scoring-tablet visibility fix; DEC-22 RED-first testing).
             Apache 2.0 license — OSS-compliant per DEC-3.
             4.11.0: latest stable, supports CSS2.1 cascade + window.getComputedStyle. -->
        <htmlunit.version>4.11.0</htmlunit.version>
    </properties>

    <!-- ===================================================================
         Dependency Management
         =================================================================== -->
    <dependencyManagement>
        <dependencies>

            <!-- Spring Boot BOM 4.0.6 — active baseline per DEC-10 (E42S01) -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Modulith BOM 2.0.6 — aligned with SB 4.0.6 (see spring-modulith.version property).
                 Manages versions for spring-modulith-starter-core, -starter-jpa, -test, etc.
                 DEC-21: adopt Modulith for vvwt-tm-web bounded-context enforcement.
                 DEC-10 C-1: version coordinate lives here; child modules MUST NOT pin. -->
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- JUnit 5 BOM (idiomatic JUnit 5 dependency-management convention) -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Pinned individually — child modules must not specify versions -->
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <!-- assertj-db: independent database-content verification for DAO integration tests.
                 Complements assertj-core by asserting on Table/Row/Column state directly against
                 the DataSource — the DAO's own read path is NOT the evaluator of its own write path. -->
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-db</artifactId>
                <version>${assertj-db.version}</version>
            </dependency>

            <!-- Testcontainers BOM — PostgreSQL ITs for vvwt-info-server (E38S03, AC3, DEC-3).
                 Provides testcontainers, testcontainers-junit-jupiter, testcontainers-postgresql.
                 OSS-compliant: Apache 2.0. Version centralised in properties. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <!-- Property-test framework: jqwik (recommended default per AC3) -->
            <dependency>
                <groupId>net.jqwik</groupId>
                <artifactId>jqwik-engine</artifactId>
                <version>${jqwik.version}</version>
            </dependency>

            <!-- ArchUnit JUnit 5 integration — build-time architecture tests (E57S05 — DEC-72 Clause E-ext).
                 Apache 2.0 license — OSS-compliant per DEC-3. Test scope only.
                 Version centralised in properties (archunit.version). -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- Own modules — managed here so siblings reference without version -->
            <dependency>
                <groupId>de.vvwt</groupId>
                <artifactId>vvwt-slotopt-worker-lib</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Public Participant Info Service modules (E38 — DEC-42) -->
            <dependency>
                <groupId>de.vvwt</groupId>
                <artifactId>vvwt-info-dto</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- RFC 8785 JCS canonical JSON (E38S05/E38S09 — AC8 / DEC-3 OSS-compliant).
                 Apache 2.0 license. Version centralised in properties block. -->
            <dependency>
                <groupId>io.github.erdtman</groupId>
                <artifactId>java-json-canonicalization</artifactId>
                <version>${java-json-canonicalization.version}</version>
            </dependency>

            <!-- Caffeine in-memory cache (E38S07 rate-limiting — DEC-3 OSS-compliant).
                 Apache 2.0 license; no proprietary transitive dependencies.
                 Used as the per-IP token-bucket backing cache in vvwt-info-server. -->
            <dependency>
                <groupId>com.github.ben-manes.caffeine</groupId>
                <artifactId>caffeine</artifactId>
                <version>${caffeine.version}</version>
            </dependency>

            <!-- HtmlUnit — headless browser for CSS-cascade + computed-style assertions.
                 E49S03: DEC-22 RED-first tests for scoring-tablet vvwtShow visibility fix.
                 Apache 2.0 license — OSS-compliant per DEC-3. Version in properties. -->
            <dependency>
                <groupId>org.htmlunit</groupId>
                <artifactId>htmlunit</artifactId>
                <version>${htmlunit.version}</version>
            </dependency>

            <!-- Standalone-worker CLI -->
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <!-- JMH -->
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
            </dependency>

            <!-- Database -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!-- ===================================================================
         Plugin Management
         =================================================================== -->
    <build>
        <pluginManagement>
            <plugins>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <!--
                             DEC-29: compiler-hygiene gate (E18S01).
                             -Xlint:all activates all javac quality warnings.
                             -Xlint:-serial: defers serial-keyset category pending
                               serialization-contract decision (DEC-29 Decision #4).
                             -Xlint:-processing: suppresses "annotations not claimed by any
                               processor" - false-positive for JUnit 5 / jqwik annotations that
                               use runtime reflection, not compile-time annotation processing.
                             -Xlint:-options: suppresses "class files found on classpath" -
                               false-positive from the release flag + annotation classpath combo;
                               not a source-quality issue.
                             failOnWarning promotes any remaining warning to BUILD FAILURE.
                        -->
                        <failOnWarning>true</failOnWarning>
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                            <arg>-Xlint:-serial</arg>
                            <arg>-Xlint:-processing</arg>
                            <arg>-Xlint:-options</arg>
                            <!-- E38S05: -parameters enables Spring Data JDBC + Spring MVC to
                                 resolve method parameter names at runtime (constructor injection,
                                 @PathVariable, @Query named params). DEC-22 compliant — this flag
                                 does not affect warning emission. -->
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven-shade-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>

                <!-- jlink distribution plugins (E02S05 — DEC-15) -->
                <!--
                    exec-maven-plugin: used to invoke jlink directly with explicit module-path.
                    maven-jlink-plugin was rejected because it adds non-modular Spring Boot deps
                    as automatic modules which jlink cannot link (see E02S05 impl-report).
                -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-maven-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>${maven-assembly-plugin.version}</version>
                </plugin>

                <!-- maven-resources-plugin: managed for version pinning (E05S01 — SPA asset copy) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>

                <!-- Frontend build plugin (E05S01 — DEC-2: Svelte/Vite npm build) -->
                <plugin>
                    <groupId>com.github.eirslett</groupId>
                    <artifactId>frontend-maven-plugin</artifactId>
                    <version>${frontend-maven-plugin.version}</version>
                </plugin>

                <!-- Spotless code formatter (E18S02 — DEC-30).
                     Scope: googleJavaFormat (AOSP) + removeUnusedImports + importOrder only.
                     No license headers, no trailing-whitespace rules, no custom rulesets —
                     narrow start per DEC-30 § Decision #6. Any scope addition requires a
                     DEC-30 amendment.
                     Execution: spotless:check binds to verify phase; developers run
                     spotless:apply locally before committing (see patterns/conventions.md). -->
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless-maven-plugin.version}</version>
                    <configuration>
                        <java>
                            <googleJavaFormat>
                                <version>${google-java-format.version}</version>
                                <style>AOSP</style>
                                <reflowLongStrings>true</reflowLongStrings>
                            </googleJavaFormat>
                            <removeUnusedImports/>
                            <importOrder/>
                        </java>
                    </configuration>
                    <executions>
                        <execution>
                            <id>spotless-check</id>
                            <phase>verify</phase>
                            <goals><goal>check</goal></goals>
                        </execution>
                    </executions>
                </plugin>

            </plugins>
        </pluginManagement>

        <!-- Activate Spotless in all modules via parent-POM inheritance (DEC-30).
             spotless:check runs at verify; spotless:apply is the manual fix command. -->
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>

            <!--
                 E44S01 (AC2, AC7): Brand-asset distribution mechanism.
                 Two exec-maven-plugin executions wired to the verify phase at parent-POM level:
                 (1) verify-brand-structure-test — asserts public/ dirs, script existence/executability,
                     and verify-brand-assets.sh behavioural contract (AC1, AC2, AC3). RED before S01
                     implementation lands, GREEN after (DEC-22 Iron Law).
                 (2) verify-brand-assets — invokes verify-brand-assets.sh to check that all vendored
                     brand-asset copies match their handoff/ masters (AC7). Exits 0 when all match
                     or when no vendored copies exist (fresh clone before first sync); exits 1 with
                     the diverging path on stderr when any file drifts.
                 Both scripts are POSIX-compatible bash; run from ${project.basedir} (the vvwt-prj root).
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <!--
                     inherited=false: these executions run ONLY at the parent POM root build
                     (when packaging=pom, i.e. the vvwt-prj root). Child modules must NOT inherit
                     them — scripts/ only exists at the vvwt-prj root, not in each submodule.
                -->
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <!-- AC1, AC2, AC3: structure + script existence + verify-contract test -->
                        <id>verify-brand-structure-test</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>scripts/verify-brand-structure-test.sh</argument>
                            </arguments>
                            <workingDirectory>${project.basedir}</workingDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- AC7: verify vendored brand assets match handoff/ masters -->
                        <id>verify-brand-assets</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>scripts/verify-brand-assets.sh</argument>
                            </arguments>
                            <workingDirectory>${project.basedir}</workingDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
