<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.vvwt</groupId>
    <artifactId>vvwt-prj</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>VVW Tournaments — Next Generation</name>
    <description>
        Parent POM for the vvwt-prj Maven multi-module project.
        Contains the slot-optimization service components (Phase 1) and
        will grow to include Tournament Manager modules in future epics.
        See DEC-10 (multi-module structure) and DEC-11 (submodule mapping).
    </description>

    <!-- Phase-1 modules (slot-optimization service) — DEC-10, DEC-11 -->
    <modules>
        <module>vvwt-worker-lib</module>
        <module>vvwt-dispatcher</module>
        <module>vvwt-standalone-worker</module>
        <module>vvwt-benchmark</module>

        <!-- Tournament Manager modules (E02+) — DEC-10, DEC-7 -->
        <module>vvwt-tm-web</module>
    </modules>

    <!-- ===================================================================
         Properties
         =================================================================== -->
    <properties>
        <!-- Java 21 baseline (DEC-10; required by Spring Boot 4.x when available) -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Dependency versions managed centrally -->
        <!-- Spring Boot: 4.0.5 is the target (DEC-10); 4.x not yet released on
             Maven Central as of bootstrap date 2026-04-11 — using 3.4.7 per AC3
             fallback chain. Update to 4.x when available. -->
        <spring-boot.version>3.4.7</spring-boot.version>

        <!-- JUnit 5 / test -->
        <junit-bom.version>5.12.2</junit-bom.version>
        <mockito.version>5.17.0</mockito.version>
        <assertj.version>3.27.3</assertj.version>
        <jqwik.version>1.9.3</jqwik.version>

        <!-- Logging -->
        <slf4j.version>2.0.17</slf4j.version>

        <!-- Standalone worker CLI -->
        <picocli.version>4.7.6</picocli.version>

        <!-- JMH (benchmark) -->
        <jmh.version>1.37</jmh.version>

        <!-- Database -->
        <postgresql.version>42.7.5</postgresql.version>
        <h2.version>2.3.232</h2.version>

        <!-- Plugin versions -->
        <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.5.3</maven-failsafe-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <maven-shade-plugin.version>3.6.0</maven-shade-plugin.version>
        <maven-clean-plugin.version>3.4.1</maven-clean-plugin.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <jacoco-maven-plugin.version>0.8.13</jacoco-maven-plugin.version>

        <!-- jlink distribution plugins (E02S05 — DEC-15) -->
        <!-- exec-maven-plugin: used to invoke jlink directly (maven-jlink-plugin cannot link
             non-modular Spring Boot/H2/Flyway JARs as automatic modules — see E02S05 impl-report) -->
        <exec-maven-plugin.version>3.5.0</exec-maven-plugin.version>
        <maven-dependency-plugin.version>3.8.1</maven-dependency-plugin.version>
        <maven-assembly-plugin.version>3.7.1</maven-assembly-plugin.version>

        <!-- Frontend build plugin (E05S01 — DEC-2: Svelte/Vite npm build wired into Maven) -->
        <!-- frontend-maven-plugin: downloads pinned Node.js/npm to target/node/, runs npm scripts.
             Choice rationale: no system Node dependency in CI; well-supported Maven+npm bridge. -->
        <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
        <!-- Node.js version pinned here so it can be updated in one place. -->
        <node.version>v22.22.2</node.version>
        <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
    </properties>

    <!-- ===================================================================
         Dependency Management
         =================================================================== -->
    <dependencyManagement>
        <dependencies>

            <!-- Spring Boot BOM (fallback: 3.4.7 — see note in properties) -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- JUnit 5 BOM (idiomatic JUnit 5 dependency-management convention) -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Pinned individually — child modules must not specify versions -->
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <!-- Property-test framework: jqwik (recommended default per AC3) -->
            <dependency>
                <groupId>net.jqwik</groupId>
                <artifactId>jqwik-engine</artifactId>
                <version>${jqwik.version}</version>
            </dependency>

            <!-- Own modules — managed here so siblings reference without version -->
            <dependency>
                <groupId>de.vvwt</groupId>
                <artifactId>vvwt-worker-lib</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Standalone-worker CLI -->
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <!-- JMH -->
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
            </dependency>

            <!-- Database -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!-- ===================================================================
         Plugin Management
         =================================================================== -->
    <build>
        <pluginManagement>
            <plugins>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven-shade-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>

                <!-- jlink distribution plugins (E02S05 — DEC-15) -->
                <!--
                    exec-maven-plugin: used to invoke jlink directly with explicit module-path.
                    maven-jlink-plugin was rejected because it adds non-modular Spring Boot deps
                    as automatic modules which jlink cannot link (see E02S05 impl-report).
                -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-maven-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>${maven-assembly-plugin.version}</version>
                </plugin>

                <!-- maven-resources-plugin: managed for version pinning (E05S01 — SPA asset copy) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>

                <!-- Frontend build plugin (E05S01 — DEC-2: Svelte/Vite npm build) -->
                <plugin>
                    <groupId>com.github.eirslett</groupId>
                    <artifactId>frontend-maven-plugin</artifactId>
                    <version>${frontend-maven-plugin.version}</version>
                </plugin>

            </plugins>
        </pluginManagement>
    </build>

</project>
